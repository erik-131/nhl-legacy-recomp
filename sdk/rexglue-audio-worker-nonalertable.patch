From cea95644761d3b2cd202e98600f8ff985f940afc Mon Sep 17 00:00:00 2001
From: nhl <nhl@localhost>
Date: Fri, 30 Oct 2026 23:43:04 +0100
Subject: [PATCH] NHL: Audio Worker waits non-alertable (no 1 ms APC poll)

---
 src/audio/audio_system.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/audio/audio_system.cpp b/src/audio/audio_system.cpp
index 7a711a8..872873a 100644
--- a/src/audio/audio_system.cpp
+++ b/src/audio/audio_system.cpp
@@ -106,7 +106,9 @@ void AudioSystem::WorkerThreadMain() {
     // These handles signify the number of submitted samples. Once we reach
     // 64 samples, we wait until our audio backend releases a semaphore
     // (signaling a sample has finished playing)
-    auto result = rex::thread::WaitAny(wait_handles_, rex::countof(wait_handles_), true,
+    // NHL: not alertable. On POSIX an alertable wait polls in 1 ms slices to deliver APCs,
+    // which kept this thread at 35-75 % of a core; it never receives APCs.
+    auto result = rex::thread::WaitAny(wait_handles_, rex::countof(wait_handles_), false,
                                        std::chrono::milliseconds(500));
     if (result.first == rex::thread::WaitResult::kFailed) {
       REXAPU_WARN("AudioWorker: WaitAny failed");
-- 
2.47.3

