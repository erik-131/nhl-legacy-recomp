+// ---- NHL diag: REX_GPU_PROF=1 -------------------------------------------------------
+// Timestamps (BOTTOM_OF_PIPE) are written whenever the recorded work switches category;
+// the delta between consecutive timestamps is attributed to the category that was
+// active, so each category gets the GPU time its recorded work took to drain. Logged
+// once per second as [nhl-gpuprof] (ms per second of wall time).
+namespace {
+bool NhlGpuProfEnabled() {
+  static const bool on = [] {
+    const char* e = std::getenv("REX_GPU_PROF");
+    return e && *e && *e != '0';
+  }();
+  return on;
+}
+constexpr uint32_t kNhlGpuQueries = 8192;
+uint64_t NhlGpuNowNs() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+}  // namespace
+
+void VulkanCommandProcessor::NhlGpuMark(uint32_t cat) {
+  if (!NhlGpuProfEnabled() || !submission_open_ || nhl_gpu_pool_ == VK_NULL_HANDLE) return;
+  if (cat == nhl_gpu_cur_cat_) return;
+  if (nhl_gpu_count_ >= kNhlGpuQueries - 1) {
+    ++nhl_gpu_overflow_;
+    return;
+  }
+  deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+                                               nhl_gpu_pool_, nhl_gpu_count_++);
+  nhl_gpu_cats_.push_back(uint8_t(cat));
+  nhl_gpu_cur_cat_ = cat;
+  ++nhl_gpu_cat_marks_[cat];
+}
+
+void VulkanCommandProcessor::NhlGpuProfOnBeginSubmission() {
+  if (!NhlGpuProfEnabled()) return;
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  if (nhl_gpu_ns_per_tick_ == 0.0) {
+    VkPhysicalDeviceProperties props;
+    vulkan_device->vulkan_instance()->functions().vkGetPhysicalDeviceProperties(
+        vulkan_device->physical_device(), &props);
+    nhl_gpu_ns_per_tick_ = props.limits.timestampPeriod;
+    REXGPU_INFO("[nhl-gpuprof] enabled, timestampPeriod={} ns", nhl_gpu_ns_per_tick_);
+  }
+  NhlGpuProfPoll();
+  if (nhl_gpu_pools_free_.empty()) {
+    VkQueryPoolCreateInfo info = {};
+    info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+    info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+    info.queryCount = kNhlGpuQueries;
+    VkQueryPool pool;
+    if (dfn.vkCreateQueryPool(vulkan_device->device(), &info, nullptr, &pool) != VK_SUCCESS) {
+      nhl_gpu_pool_ = VK_NULL_HANDLE;
+      return;
+    }
+    nhl_gpu_pools_free_.push_back(pool);
+  }
+  nhl_gpu_pool_ = nhl_gpu_pools_free_.back();
+  nhl_gpu_pools_free_.pop_back();
+  nhl_gpu_count_ = 0;
+  nhl_gpu_cats_.clear();
+  nhl_gpu_cur_cat_ = UINT32_MAX;
+  NhlGpuMark(kNhlGpuOther);
+}
+
+void VulkanCommandProcessor::NhlGpuProfBeforeExecute(VkCommandBuffer cb) {
+  if (!NhlGpuProfEnabled() || nhl_gpu_pool_ == VK_NULL_HANDLE) return;
+  const ui::vulkan::VulkanDevice::Functions& dfn = GetVulkanDevice()->functions();
+  dfn.vkCmdResetQueryPool(cb, nhl_gpu_pool_, 0, kNhlGpuQueries);
+}
+
+void VulkanCommandProcessor::NhlGpuProfAfterExecute(VkCommandBuffer cb) {
+  if (!NhlGpuProfEnabled() || nhl_gpu_pool_ == VK_NULL_HANDLE) return;
+  const ui::vulkan::VulkanDevice::Functions& dfn = GetVulkanDevice()->functions();
+  dfn.vkCmdWriteTimestamp(cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, nhl_gpu_pool_,
+                          nhl_gpu_count_++);
+}
+
+void VulkanCommandProcessor::NhlGpuProfOnSubmitted(uint64_t submission) {
+  if (!NhlGpuProfEnabled() || nhl_gpu_pool_ == VK_NULL_HANDLE) return;
+  NhlGpuProfPending p;
+  p.submission = submission;
+  p.pool = nhl_gpu_pool_;
+  p.count = nhl_gpu_count_;
+  p.cats = std::move(nhl_gpu_cats_);
+  nhl_gpu_pending_.push_back(std::move(p));
+  nhl_gpu_pool_ = VK_NULL_HANDLE;
+  nhl_gpu_cats_.clear();
+}
+
+void VulkanCommandProcessor::NhlGpuProfPoll() {
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const uint64_t completed = GetCompletedSubmission();
+  std::vector<uint64_t> ts;
+  while (!nhl_gpu_pending_.empty() && nhl_gpu_pending_.front().submission <= completed) {
+    NhlGpuProfPending& p = nhl_gpu_pending_.front();
+    ts.resize(p.count);
+    if (p.count >= 2 &&
+        dfn.vkGetQueryPoolResults(vulkan_device->device(), p.pool, 0, p.count,
+                                  sizeof(uint64_t) * p.count, ts.data(), sizeof(uint64_t),
+                                  VK_QUERY_RESULT_64_BIT) == VK_SUCCESS) {
+      for (uint32_t i = 0; i + 1 < p.count; ++i) {
+        const uint8_t cat = i < p.cats.size() ? p.cats[i] : uint8_t(kNhlGpuOther);
+        if (ts[i + 1] > ts[i]) nhl_gpu_cat_ticks_[cat] += ts[i + 1] - ts[i];
+      }
+      if (ts[p.count - 1] > ts[0]) nhl_gpu_busy_ticks_ += ts[p.count - 1] - ts[0];
+      if (nhl_gpu_last_end_tick_ && ts[0] > nhl_gpu_last_end_tick_) {
+        const uint64_t gap = ts[0] - nhl_gpu_last_end_tick_;
+        // Ignore gaps > 1 s (timer wrap / long pause).
+        if (gap * nhl_gpu_ns_per_tick_ < 1e9) nhl_gpu_idle_ticks_ += gap;
+      }
+      nhl_gpu_last_end_tick_ = ts[p.count - 1];
+      ++nhl_gpu_submissions_;
+    }
+    nhl_gpu_pools_free_.push_back(p.pool);
+    nhl_gpu_pending_.pop_front();
+  }
+  const uint64_t now = NhlGpuNowNs();
+  if (!nhl_gpu_window_start_ns_) nhl_gpu_window_start_ns_ = now;
+  if (now - nhl_gpu_window_start_ns_ >= 1000000000ull) {
+    static const char* kNames[kNhlGpuCatCount] = {"other",  "prep", "tex",     "rt",
+                                                  "upload", "draw", "resolve", "swap"};
+    const double w = (now - nhl_gpu_window_start_ns_) / 1e6;
+    const double k = nhl_gpu_ns_per_tick_ / 1e6;
+    std::string out;
+    for (uint32_t c = 0; c < kNhlGpuCatCount; ++c) {
+      out += fmt::format(" {}={:.1f}ms/{}", kNames[c], nhl_gpu_cat_ticks_[c] * k,
+                         nhl_gpu_cat_marks_[c]);
+    }
+    REXGPU_INFO("[nhl-gpuprof] window={:.0f}ms busy={:.1f}ms idle_gaps={:.1f}ms subs={} "
+                "overflow={}{}",
+                w, nhl_gpu_busy_ticks_ * k, nhl_gpu_idle_ticks_ * k, nhl_gpu_submissions_,
+                nhl_gpu_overflow_, out);
+    std::memset(nhl_gpu_cat_ticks_, 0, sizeof(nhl_gpu_cat_ticks_));
+    std::memset(nhl_gpu_cat_marks_, 0, sizeof(nhl_gpu_cat_marks_));
+    nhl_gpu_busy_ticks_ = nhl_gpu_idle_ticks_ = nhl_gpu_submissions_ = nhl_gpu_overflow_ = 0;
+    nhl_gpu_window_start_ns_ = now;
+  }
+}
