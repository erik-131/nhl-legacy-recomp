+
+uint32_t VulkanCommandProcessor::NhlBarrierSignatureCode() {
+  // Signature of the barriers about to be submitted: stage masks, buffer/image counts, and for
+  // images the aspect and old -> new layout.
+  static const char* kLayouts[] = {"U", "G", "CA", "DA", "DR", "SR", "TS", "TD"};
+  auto layout = [](VkImageLayout l) -> const char* {
+    switch (l) {
+      case VK_IMAGE_LAYOUT_UNDEFINED: return "U";
+      case VK_IMAGE_LAYOUT_GENERAL: return "G";
+      case VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL: return "CA";
+      case VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL: return "DA";
+      case VK_IMAGE_LAYOUT_DEPTH_STENCIL_READ_ONLY_OPTIMAL: return "DR";
+      case VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL: return "SR";
+      case VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL: return "TS";
+      case VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL: return "TD";
+      default: return "?";
+    }
+  };
+  (void)kLayouts;
+  std::string t;
+  const size_t n = pending_barriers_.size();
+  for (size_t i = 0; i < n; ++i) {
+    const PendingBarrier& b = pending_barriers_[i];
+    size_t b_end = i + 1 < n ? pending_barriers_[i + 1].buffer_memory_barriers_offset
+                             : pending_barriers_buffer_memory_barriers_.size();
+    size_t i_end = i + 1 < n ? pending_barriers_[i + 1].image_memory_barriers_offset
+                             : pending_barriers_image_memory_barriers_.size();
+    t += fmt::format("{}s{:X}>{:X} b{}", i ? " | " : "", b.src_stage_mask, b.dst_stage_mask,
+                     b_end - b.buffer_memory_barriers_offset);
+    for (size_t j = b.image_memory_barriers_offset; j < i_end; ++j) {
+      const VkImageMemoryBarrier& im = pending_barriers_image_memory_barriers_[j];
+      t += fmt::format(" i{}{}>{}", (im.subresourceRange.aspectMask & VK_IMAGE_ASPECT_COLOR_BIT) ? "c" : "d",
+                       layout(im.oldLayout), layout(im.newLayout));
+    }
+  }
+  std::string key = fmt::format("{}|{}", nhl_phase_, t);
+  auto it = nhl_bar_sig_index_.find(key);
+  uint32_t idx;
+  if (it == nhl_bar_sig_index_.end()) {
+    if (nhl_bar_sigs_.size() >= 199) return kNhlGpuBarrierBase + 199;
+    idx = uint32_t(nhl_bar_sigs_.size());
+    nhl_bar_sigs_.push_back({nhl_phase_, t});
+    nhl_bar_sig_index_.emplace(key, idx);
+  } else {
+    idx = it->second;
+  }
+  return kNhlGpuBarrierBase + idx;
+}
+
+void VulkanCommandProcessor::NhlGpuMark(uint32_t cat) {
+  nhl_phase_ = cat;
+  NhlGpuMarkCode(cat);
+}
+
+void VulkanCommandProcessor::NhlGpuMarkCode(uint32_t cat) {
+  if (!NhlGpuProfEnabled() || !submission_open_ || nhl_gpu_pool_ == VK_NULL_HANDLE) return;
+  static const bool by_shader = std::getenv("REX_GPU_PROF_SHADERS") != nullptr;
+  const uint64_t tag = (cat == kNhlGpuResolve || cat == kNhlGpuDump)
+                           ? nhl_gpu_resolve_tag_
+                           : ((by_shader && cat == kNhlGpuDraw) ? nhl_gpu_draw_tag_ : 0);
+  if (cat == nhl_gpu_cur_cat_ && tag == nhl_gpu_cur_tag_) return;
+  if (nhl_gpu_count_ >= kNhlGpuQueries - 1) {
+    ++nhl_gpu_overflow_;
+    return;
+  }
+  deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+                                               nhl_gpu_pool_, nhl_gpu_count_++);
+  nhl_gpu_cats_.push_back(uint8_t(cat));
+  nhl_gpu_tags_.push_back(tag);
+  nhl_gpu_cur_cat_ = cat;
+  nhl_gpu_cur_tag_ = tag;
+  if (cat >= kNhlGpuBarrierBase) {
+    ++nhl_gpu_bar_marks_[cat - kNhlGpuBarrierBase];
+  } else {
+    ++nhl_gpu_cat_marks_[cat];
+  }
+}
+
+void VulkanCommandProcessor::NhlGpuProfOnBeginSubmission() {
+  if (!NhlGpuProfEnabled()) return;
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  if (nhl_gpu_ns_per_tick_ == 0.0) {
+    VkPhysicalDeviceProperties props;
+    vulkan_device->vulkan_instance()->functions().vkGetPhysicalDeviceProperties(
+        vulkan_device->physical_device(), &props);
+    nhl_gpu_ns_per_tick_ = props.limits.timestampPeriod;
+    REXGPU_INFO("[nhl-gpuprof] enabled, timestampPeriod={} ns", nhl_gpu_ns_per_tick_);
+  }
+  NhlGpuProfPoll();
+  if (nhl_gpu_pools_free_.empty()) {
+    VkQueryPoolCreateInfo info = {};
+    info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+    info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+    info.queryCount = kNhlGpuQueries;
+    VkQueryPool pool;
+    if (dfn.vkCreateQueryPool(vulkan_device->device(), &info, nullptr, &pool) != VK_SUCCESS) {
+      nhl_gpu_pool_ = VK_NULL_HANDLE;
+      return;
+    }
+    nhl_gpu_pools_free_.push_back(pool);
+  }
+  nhl_gpu_pool_ = nhl_gpu_pools_free_.back();
+  nhl_gpu_pools_free_.pop_back();
+  nhl_gpu_count_ = 0;
+  nhl_gpu_cats_.clear();
+  nhl_gpu_tags_.clear();
+  nhl_gpu_cur_cat_ = UINT32_MAX;
+  nhl_gpu_cur_tag_ = 0;
+  NhlGpuMark(kNhlGpuOther);
+}
+
+void VulkanCommandProcessor::NhlGpuProfBeforeExecute(VkCommandBuffer cb) {
+  if (!NhlGpuProfEnabled() || nhl_gpu_pool_ == VK_NULL_HANDLE) return;
+  const ui::vulkan::VulkanDevice::Functions& dfn = GetVulkanDevice()->functions();
+  dfn.vkCmdResetQueryPool(cb, nhl_gpu_pool_, 0, kNhlGpuQueries);
+}
+
+void VulkanCommandProcessor::NhlGpuProfAfterExecute(VkCommandBuffer cb) {
+  if (!NhlGpuProfEnabled() || nhl_gpu_pool_ == VK_NULL_HANDLE) return;
+  const ui::vulkan::VulkanDevice::Functions& dfn = GetVulkanDevice()->functions();
+  dfn.vkCmdWriteTimestamp(cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, nhl_gpu_pool_,
+                          nhl_gpu_count_++);
+}
+
+void VulkanCommandProcessor::NhlGpuProfOnSubmitted(uint64_t submission) {
+  if (!NhlGpuProfEnabled() || nhl_gpu_pool_ == VK_NULL_HANDLE) return;
+  NhlGpuProfPending p;
+  p.submission = submission;
+  p.pool = nhl_gpu_pool_;
+  p.count = nhl_gpu_count_;
+  p.cats = std::move(nhl_gpu_cats_);
+  p.tags = std::move(nhl_gpu_tags_);
+  nhl_gpu_tags_.clear();
+  nhl_gpu_pending_.push_back(std::move(p));
+  nhl_gpu_pool_ = VK_NULL_HANDLE;
+  nhl_gpu_cats_.clear();
+}
