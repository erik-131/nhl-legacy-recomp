+// Pointer to a guest register (float4), or to one component of it when `component` is given.
+spv::Id SpirvShaderTranslator::GetRegisterPointer(spv::Id index, spv::Id component) {
+  if (!var_main_register_vars_.empty()) {
+    // Static addressing: the index is always a constant.
+    assert_true(builder_->isConstant(index));
+    uint32_t register_index = builder_->getConstantScalar(index);
+    assert_true(register_index < var_main_register_vars_.size());
+    spv::Id variable = var_main_register_vars_[register_index];
+    if (component == spv::NoResult) {
+      return variable;
+    }
+    id_vector_temp_register_.clear();
+    id_vector_temp_register_.push_back(component);
+    return builder_->createAccessChain(spv::StorageClassFunction, variable, id_vector_temp_register_);
+  }
+  assert_true(var_main_registers_ != spv::NoResult);
+  id_vector_temp_register_.clear();
+  id_vector_temp_register_.push_back(index);
+  if (component != spv::NoResult) {
+    id_vector_temp_register_.push_back(component);
+  }
+  return builder_->createAccessChain(spv::StorageClassFunction, var_main_registers_,
+                                     id_vector_temp_register_);
+}
