+void VulkanCommandProcessor::NhlFlushReadbackBatch() {
+  if (nhl_rb_batch_.empty()) {
+    return;
+  }
+  shared_memory_->Use(VulkanSharedMemory::Usage::kRead);
+  SubmitBarriers(true);
+  for (const NhlReadbackPending& pending : nhl_rb_batch_) {
+    auto it = readback_buffers_.find(pending.key);
+    if (it == readback_buffers_.end() || it->second.buffers[pending.write_index] == VK_NULL_HANDLE) {
+      continue;
+    }
+    VkBufferCopy region = {};
+    region.srcOffset = pending.address;
+    region.dstOffset = 0;
+    region.size = pending.length;
+    deferred_command_buffer_.CmdVkCopyBuffer(shared_memory_->buffer(),
+                                             it->second.buffers[pending.write_index], 1, &region);
+    PushBufferMemoryBarrier(it->second.buffers[pending.write_index], 0, pending.length,
+                            VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT,
+                            VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_HOST_READ_BIT);
+    ++nhl_rb_issued_;
+  }
+  nhl_rb_batch_.clear();
