 endif()
 
+# Prebuilt (IMPORTED) FidelityFX libraries can't be install(TARGETS)/exported —
+# they're DELAYLOAD'd into the rexruntime shared lib, so only the DLL needs to
+# ship. Install those as files; build-in-tree targets go through install(TARGETS).
 set(REXGLUE_INSTALL_FIDELITYFX_TARGETS)
-if(TARGET amd_fidelityfx_vk)
-    list(APPEND REXGLUE_INSTALL_FIDELITYFX_TARGETS amd_fidelityfx_vk)
-endif()
-
-if(TARGET amd_fidelityfx_dx12)
-    list(APPEND REXGLUE_INSTALL_FIDELITYFX_TARGETS amd_fidelityfx_dx12)
-endif()
+foreach(_ffx_tgt amd_fidelityfx_vk amd_fidelityfx_dx12)
+    if(TARGET ${_ffx_tgt})
+        get_target_property(_ffx_imported ${_ffx_tgt} IMPORTED)
+        if(_ffx_imported)
+            get_target_property(_ffx_dll ${_ffx_tgt} IMPORTED_LOCATION)
+            get_target_property(_ffx_lib ${_ffx_tgt} IMPORTED_IMPLIB)
+            if(_ffx_dll)
+                install(FILES "${_ffx_dll}" DESTINATION ${CMAKE_INSTALL_BINDIR})
+            endif()
+            if(_ffx_lib)
+                install(FILES "${_ffx_lib}" DESTINATION ${CMAKE_INSTALL_LIBDIR})
+            endif()
+        else()
+            list(APPEND REXGLUE_INSTALL_FIDELITYFX_TARGETS ${_ffx_tgt})
+        endif()
+    endif()
+endforeach()
 
 install(TARGETS ${REXGLUE_INSTALL_TARGETS}
     EXPORT rexglueTargets
