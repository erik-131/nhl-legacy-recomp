+uint32_t VulkanRenderTargetCache::ClearThroughAliases(
+    const memory::Memory& memory, reg::RB_DEPTHCONTROL normalized_depth_control,
+    uint32_t normalized_color_mask, const Shader& vertex_shader, const Shader* pixel_shader,
+    bool* depth_cleared_out) {
+  *depth_cleared_out = false;
+  const bool try_depth = REXCVAR_GET(nhl_rt_clear_through_depth);
+  if (!REXCVAR_GET(nhl_rt_clear_through) || GetPath() != Path::kHostRenderTargets ||
+      (!normalized_color_mask && !try_depth) || (normalized_color_mask && !pixel_shader)) {
+    return 0;
+  }
+  auto regs_rectangle_list_of_3 = [this]() {
+    auto draw_initiator = register_file().Get<reg::VGT_DRAW_INITIATOR>();
+    return draw_initiator.prim_type == xenos::PrimitiveType::kRectangleList &&
+           draw_initiator.num_indices == 3 &&
+           draw_initiator.source_select == xenos::SourceSelect::kAutoIndex;
+  };
+  if (vertex_shader.ucode_data_hash() !=
+          std::strtoull(REXCVAR_GET(nhl_rt_clear_vertex_shader_hash).c_str(), nullptr, 16) ||
+      (pixel_shader &&
+       pixel_shader->ucode_data_hash() !=
+           std::strtoull(REXCVAR_GET(nhl_rt_clear_pixel_shader_hash).c_str(), nullptr, 16))) {
+    // Name the shaders of draws that would qualify otherwise, once per pair, so the hashes of
+    // this game's clear shaders can be configured.
+    if (regs_rectangle_list_of_3() && pixel_shader) {
+      nhl_overwrite_pixel_shader = pixel_shader;
+      Transfer::Rectangle candidate_rectangle;
+      if (GetDrawOverwrittenRenderTargets(normalized_depth_control, normalized_color_mask,
+                                          vertex_shader, candidate_rectangle) &
+          ~uint32_t(1)) {
+        static std::set<std::pair<uint64_t, uint64_t>> logged;
+        if (logged.emplace(vertex_shader.ucode_data_hash(), pixel_shader->ucode_data_hash())
+                .second) {
+          REXGPU_INFO("[nhl-clearthrough] overwriting rectangle-list draw with VS {:016X} "
+                      "PS {:016X} ({}x{}) - not the configured clear shaders",
+                      vertex_shader.ucode_data_hash(), pixel_shader->ucode_data_hash(),
+                      candidate_rectangle.width_pixels, candidate_rectangle.height_pixels);
+        }
+      }
+    }
+    return 0;
+  }
+  // The colors the draw provably replaces in the rectangle (depth and stencil may be written
+  // too - they're still drawn).
+  nhl_overwrite_pixel_shader = pixel_shader;
+  Transfer::Rectangle rectangle;
+  uint32_t overwritten_with_depth = GetDrawOverwrittenRenderTargets(
+      normalized_depth_control, normalized_color_mask, vertex_shader, rectangle);
+  const float overwrite_z = nhl_overwrite_z_;
+  uint32_t overwritten = overwritten_with_depth & ~uint32_t(1);
+  if (!overwritten && !(try_depth && (overwritten_with_depth & 1))) {
+    return 0;
+  }
+  const RegisterFile& regs = register_file();
+
+  // The clear color, constant across the vertices: the clear vertex shader takes xyz (w = 1)
+  // and the color from its only vertex stream, and the pixel shader outputs it.
+  const std::vector<Shader::VertexBinding>& bindings = vertex_shader.vertex_bindings();
+  if (bindings.size() != 1 || bindings[0].stride_words < 7) {
+    return 0;
+  }
+  uint32_t stride = bindings[0].stride_words;
+  xenos::xe_gpu_vertex_fetch_t fetch = regs.GetVertexFetch(bindings[0].fetch_constant);
+  if (fetch.type != xenos::FetchConstantType::kVertex || fetch.size < stride * 2 + 7) {
+    return 0;
+  }
+  const uint32_t* vertices =
+      memory.TranslatePhysical<const uint32_t*>(fetch.address * sizeof(uint32_t));
+  if (!vertices) {
+    return 0;
+  }
+  uint32_t color_bits[4];
+  for (uint32_t i = 0; i < 3; ++i) {
+    for (uint32_t j = 0; j < 4; ++j) {
+      uint32_t value = xenos::GpuSwap(vertices[stride * i + 3 + j], fetch.endian);
+      if (!i) {
+        color_bits[j] = value;
+      } else if (value != color_bits[j]) {
+        return 0;
+      }
+    }
+  }
+  float color[4];
+  std::memcpy(color, color_bits, sizeof(color));
+  for (uint32_t j = 0; j < 4; ++j) {
+    if (!std::isfinite(color[j])) {
+      return 0;
+    }
+    color[j] = std::clamp(color[j], 0.0f, 1.0f);
+  }
+
+  // Whole rows of tiles of the surface: a contiguous range of EDRAM tiles, whatever the layout
+  // of the render target owning it.
+  auto surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  uint32_t msaa_samples_x_log2 = uint32_t(surface_info.msaa_samples >= xenos::MsaaSamples::k4X);
+  uint32_t msaa_samples_y_log2 = uint32_t(surface_info.msaa_samples >= xenos::MsaaSamples::k2X);
+  uint32_t pitch_tiles = ((uint32_t(surface_info.surface_pitch) << msaa_samples_x_log2) +
+                          (xenos::kEdramTileWidthSamples - 1)) /
+                         xenos::kEdramTileWidthSamples;
+  uint32_t tile_width = xenos::kEdramTileWidthSamples >> msaa_samples_x_log2;
+  uint32_t tile_height = xenos::kEdramTileHeightSamples >> msaa_samples_y_log2;
+  if (!pitch_tiles || rectangle.x_pixels ||
+      rectangle.width_pixels < pitch_tiles * tile_width || rectangle.y_pixels % tile_height ||
+      rectangle.height_pixels % tile_height) {
+    return 0;
+  }
+  uint32_t first_row = rectangle.y_pixels / tile_height;
+  uint32_t row_count = rectangle.height_pixels / tile_height;
+
+  uint32_t cleared_color_mask = 0;
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    if (!(overwritten & (uint32_t(1) << (1 + i)))) {
+      continue;
+    }
+    auto color_info = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[i]);
+    // Unorm formats stored the same way from a clear value as from the pixel shader.
+    uint64_t clear_value;
+    switch (color_info.color_format) {
+      case xenos::ColorRenderTargetFormat::k_8_8_8_8:
+        clear_value = 0;
+        for (uint32_t j = 0; j < 4; ++j) {
+          clear_value |= uint64_t(uint32_t(color[j] * 255.0f + 0.5f)) << (j * 8);
+        }
+        break;
+      case xenos::ColorRenderTargetFormat::k_2_10_10_10:
+      case xenos::ColorRenderTargetFormat::k_2_10_10_10_AS_10_10_10_10:
+        clear_value = 0;
+        for (uint32_t j = 0; j < 3; ++j) {
+          clear_value |= uint64_t(uint32_t(color[j] * 1023.0f + 0.5f)) << (j * 10);
+        }
+        clear_value |= uint64_t(uint32_t(color[3] * 3.0f + 0.5f)) << 30;
+        break;
+      default:
+        continue;
+    }
+    if (color_info.color_exp_bias) {
+      continue;
+    }
+    uint32_t start_tiles = color_info.color_base + first_row * pitch_tiles;
+    uint32_t end_tiles = start_tiles + row_count * pitch_tiles;
+    RenderTarget* owner = GetSingleColorOwner(start_tiles, end_tiles, color_info.color_format);
+    if (!owner) {
+      ++nhl_transfer_stats.color_no_owner;
+      static uint32_t logged_color_owner = 0;
+      if (REXCVAR_GET(nhl_rt_transfer_stats) && logged_color_owner < 20) {
+        ++logged_color_owner;
+        REXGPU_INFO("[nhl-clearthrough] color {}: no single owner of tiles [{}, {}) fmt {}", i,
+                    start_tiles, end_tiles, uint32_t(color_info.color_format));
+      }
+      continue;
+    }
+    RenderTargetKey owner_key = owner->key();
+    if (start_tiles < owner_key.base_tiles) {
+      // Owned through EDRAM addressing wrapping - not handled.
+      continue;
+    }
+    Transfer::Rectangle owner_rectangles[Transfer::kMaxRectanglesWithoutCutout];
+    uint32_t owner_rectangle_count = Transfer::GetRangeRectangles(
+        start_tiles, end_tiles, owner_key.base_tiles, owner_key.GetPitchTiles(),
+        owner_key.msaa_samples, owner_key.Is64bpp(), owner_rectangles);
+    std::vector<Transfer> no_transfers;
+    // nhl_rt_debug_poison_overwrites: garbage first, the clear must replace all of it.
+    bool poison = REXCVAR_GET(nhl_rt_debug_poison_overwrites);
+    for (uint32_t j = 0; j < owner_rectangle_count; ++j) {
+      if (poison) {
+        uint64_t poison_value = 0x5A5AA5A55A5AA5A5ull;
+        PerformTransfersAndResolveClears(1, &owner, &no_transfers, &poison_value,
+                                         &owner_rectangles[j]);
+      }
+      PerformTransfersAndResolveClears(1, &owner, &no_transfers, &clear_value,
+                                       &owner_rectangles[j]);
+    }
+    nhl_transfer_stats.cleared_through_tiles += end_tiles - start_tiles;
+    if (nhl_log_ownership) {
+      REXGPU_INFO("[nhl-own] clear-through color {} [{},{}) owner {:08X}", i, start_tiles, end_tiles,
+                  owner_key.key);
+    }
+    cleared_color_mask |= uint32_t(0b1111) << (4 * i);
+  }
+
+  // Depth and stencil: only when the draw has nothing left to draw but them.
+  if (try_depth && (overwritten_with_depth & 1) && cleared_color_mask == normalized_color_mask) {
+    auto depth_info = regs.Get<reg::RB_DEPTH_INFO>();
+    auto sc_mode_cntl = regs.Get<reg::PA_SU_SC_MODE_CNTL>();
+    reg::RB_STENCILREFMASK stencil_ref_mask = regs.Get<reg::RB_STENCILREFMASK>();
+    reg::RB_STENCILREFMASK stencil_ref_mask_bf;
+    stencil_ref_mask_bf.value = regs[XE_GPU_REG_RB_STENCILREFMASK_BF];
+    // The host stores the depth as a 24-bit unorm rounded to nearest: anything within half a
+    // step of 0 or 1 (the clear quads' viewport math gives -3.7e-9, say) is exactly that.
+    constexpr float kHalfStep = 1.0f / 33554432.0f;
+    const bool z_is_0 = overwrite_z <= kHalfStep;
+    const bool z_is_1 = overwrite_z >= 1.0f - kHalfStep;
+    bool z_known = z_is_0 || z_is_1;
+    bool format_ok = depth_info.depth_format == xenos::DepthRenderTargetFormat::kD24S8 &&
+                     !IsHostDepthEncodingDifferent(xenos::DepthRenderTargetFormat::kD24S8);
+    bool offset_ok = !sc_mode_cntl.poly_offset_front_enable && !sc_mode_cntl.poly_offset_back_enable;
+    bool stencil_ok = !normalized_depth_control.backface_enable ||
+                      stencil_ref_mask.stencilref == stencil_ref_mask_bf.stencilref;
+    if (z_known && format_ok && offset_ok && stencil_ok) {
+      uint32_t start_tiles = depth_info.depth_base + first_row * pitch_tiles;
+      uint32_t end_tiles = start_tiles + row_count * pitch_tiles;
+      RenderTarget* owner = GetSingleDepthOwner(start_tiles, end_tiles,
+                                                xenos::DepthRenderTargetFormat::kD24S8);
+      if (!owner) {
+        ++nhl_transfer_stats.depth_no_owner;
+        static uint32_t logged_owner = 0;
+        if (REXCVAR_GET(nhl_rt_transfer_stats) && logged_owner < 20) {
+          ++logged_owner;
+          REXGPU_INFO("[nhl-clearthrough] depth: no single D24S8 owner of tiles [{}, {})",
+                      start_tiles, end_tiles);
+        }
+      }
+      if (owner && start_tiles >= owner->key().base_tiles) {
+        RenderTargetKey owner_key = owner->key();
+        Transfer::Rectangle owner_rectangles[Transfer::kMaxRectanglesWithoutCutout];
+        uint32_t owner_rectangle_count = Transfer::GetRangeRectangles(
+            start_tiles, end_tiles, owner_key.base_tiles, owner_key.GetPitchTiles(),
+            owner_key.msaa_samples, owner_key.Is64bpp(), owner_rectangles);
+        std::vector<Transfer> no_transfers;
+        bool poison = REXCVAR_GET(nhl_rt_debug_poison_overwrites);
+        uint64_t clear_value = (uint64_t(z_is_1 ? 0xFFFFFFu : 0u) << 8) |
+                               stencil_ref_mask.stencilref;
+        for (uint32_t j = 0; j < owner_rectangle_count; ++j) {
+          if (poison) {
+            uint64_t poison_value = 0x5A5AA5A55A5AA5A5ull;
+            PerformTransfersAndResolveClears(1, &owner, &no_transfers, &poison_value,
+                                             &owner_rectangles[j]);
+          }
+          PerformTransfersAndResolveClears(1, &owner, &no_transfers, &clear_value,
+                                           &owner_rectangles[j]);
+        }
+        nhl_transfer_stats.cleared_through_depth_tiles += end_tiles - start_tiles;
+        if (nhl_log_ownership) {
+          REXGPU_INFO("[nhl-own] clear-through depth [{},{}) owner {:08X}", start_tiles, end_tiles,
+                      owner_key.key);
+        }
+        *depth_cleared_out = true;
+      }
+    }
+    if (!*depth_cleared_out) {
+      ++nhl_transfer_stats.clear_through_depth_refused;
+      nhl_transfer_stats.depth_not_z += !z_known;
+      static uint32_t logged = 0;
+      if (REXCVAR_GET(nhl_rt_transfer_stats) && logged < 40) {
+        ++logged;
+        REXGPU_INFO("[nhl-clearthrough] depth refused: z={} z_known={} format_ok={} (fmt {}) "
+                    "offset_ok={} stencil_ok={} base={} first_row={} rows={} pitch={}",
+                    overwrite_z, z_known, format_ok, uint32_t(depth_info.depth_format), offset_ok,
+                    stencil_ok, uint32_t(depth_info.depth_base), first_row, row_count, pitch_tiles);
+      }
+    }
+  }
+  return cleared_color_mask;
+}
+
+uint32_t VulkanRenderTargetCache::GetDrawOverwrittenRenderTargets(
+    reg::RB_DEPTHCONTROL normalized_depth_control, uint32_t normalized_color_mask,
+    const Shader& vertex_shader, Transfer::Rectangle& rectangle_out) {
+  nhl_overwrite_z_ = std::numeric_limits<float>::quiet_NaN();
+  // Ported from The Simpsons Game recomp's native renderer (CPU vertex shader proofs only).
+  // Coverage alone doesn't prove an overwrite if depth or stencil can reject fragments.
+  if ((normalized_depth_control.z_enable &&
+       normalized_depth_control.zfunc != xenos::CompareFunction::kAlways) ||
+      (normalized_depth_control.stencil_enable &&
+       (normalized_depth_control.stencilfunc != xenos::CompareFunction::kAlways ||
+        (normalized_depth_control.backface_enable &&
+         normalized_depth_control.stencilfunc_bf != xenos::CompareFunction::kAlways)))) {
+    return 0;
+  }
+  const RegisterFile& regs = register_file();
+  auto draw_initiator = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  if (draw_initiator.prim_type != xenos::PrimitiveType::kRectangleList ||
+      draw_initiator.num_indices != 3 ||
+      draw_initiator.source_select != xenos::SourceSelect::kAutoIndex) {
+    return 0;
+  }
+  // The render targets the draw replaces wherever it covers: depth and stencil both fully
+  // replaced, and colors with full write masks and opaque blending.
+  uint32_t overwritten = 0;
+  if (normalized_depth_control.z_enable && normalized_depth_control.z_write_enable &&
+      normalized_depth_control.zfunc == xenos::CompareFunction::kAlways &&
+      normalized_depth_control.stencil_enable &&
+      normalized_depth_control.stencilfunc == xenos::CompareFunction::kAlways &&
+      normalized_depth_control.stencilzpass == xenos::StencilOp::kReplace &&
+      regs.Get<reg::RB_STENCILREFMASK>().stencilwritemask == 0xFF) {
+    bool back_replaced = true;
+    if (normalized_depth_control.backface_enable) {
+      reg::RB_STENCILREFMASK stencil_ref_mask_bf;
+      stencil_ref_mask_bf.value = regs[XE_GPU_REG_RB_STENCILREFMASK_BF];
+      back_replaced = normalized_depth_control.stencilfunc_bf == xenos::CompareFunction::kAlways &&
+                      normalized_depth_control.stencilzpass_bf == xenos::StencilOp::kReplace &&
+                      stencil_ref_mask_bf.stencilwritemask == 0xFF;
+    }
+    if (back_replaced) {
+      overwritten |= 1;
+    }
+  }
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    // The normalized mask has components the format doesn't have set too.
+    if (((normalized_color_mask >> (4 * i)) & 0b1111) != 0b1111) {
+      continue;
+    }
+    auto blend_control =
+        regs.Get<reg::RB_BLENDCONTROL>(reg::RB_BLENDCONTROL::rt_register_indices[i]);
+    if (blend_control.color_srcblend != xenos::BlendFactor::kOne ||
+        blend_control.color_destblend != xenos::BlendFactor::kZero ||
+        blend_control.color_comb_fcn != xenos::BlendOp::kAdd ||
+        blend_control.alpha_srcblend != xenos::BlendFactor::kOne ||
+        blend_control.alpha_destblend != xenos::BlendFactor::kZero ||
+        blend_control.alpha_comb_fcn != xenos::BlendOp::kAdd) {
+      continue;
+    }
+    overwritten |= uint32_t(1) << (1 + i);
+  }
+  if (!overwritten) {
+    return 0;
+  }
+  auto sc_mode_cntl = regs.Get<reg::PA_SU_SC_MODE_CNTL>();
+  if (sc_mode_cntl.cull_front || sc_mode_cntl.cull_back ||
+      sc_mode_cntl.poly_mode != xenos::PolygonModeEnable::kDisabled) {
+    return 0;
+  }
+  auto surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  if (surface_info.msaa_samples != xenos::MsaaSamples::k1X) {
+    uint32_t sample_mask = (uint32_t(1) << (uint32_t(1) << uint32_t(surface_info.msaa_samples))) - 1;
+    if ((regs[XE_GPU_REG_PA_SC_AA_MASK] & sample_mask) != sample_mask) {
+      return 0;
+    }
+  }
+  const Shader* pixel_shader = nhl_overwrite_pixel_shader;
+  if (pixel_shader && (pixel_shader->kills_pixels() || pixel_shader->writes_depth())) {
+    return 0;
+  }
+  auto color_control = regs.Get<reg::RB_COLORCONTROL>();
+  if (color_control.alpha_to_mask_enable ||
+      (color_control.alpha_test_enable &&
+       color_control.alpha_func != xenos::CompareFunction::kAlways)) {
+    return 0;
+  }
+  auto clip_cntl = regs.Get<reg::PA_CL_CLIP_CNTL>();
+  bool clip_disable = clip_cntl.clip_disable;
+  if (!clip_disable && (clip_cntl.value & 0b111111)) {
+    // User clip planes.
+    return 0;
+  }
+  float positions[3][4];
+  if (!draw_extent_estimator().GetAutoIndexedVertexPositions(vertex_shader, 3, positions)) {
+    return 0;
+  }
+  auto vte_cntl = regs.Get<reg::PA_CL_VTE_CNTL>();
+  auto reg_float = [&regs](uint32_t index) {
+    float value;
+    std::memcpy(&value, &regs[index], sizeof(value));
+    return value;
+  };
+  float half_pixel_offset =
+      regs.Get<reg::PA_SU_VTX_CNTL>().pix_center == xenos::PixelCenter::kD3DZero ? 0.5f : 0.0f;
+  int32_t x_fixed[3], y_fixed[3];
+  float z_final[3];
+  for (uint32_t i = 0; i < 3; ++i) {
+    // The position as the host gets it: the shader may return 1/W, and Z/W instead of Z
+    // (VTX_W0_FMT and VTX_Z_FMT, see the shader translator).
+    const float* p = positions[i];
+    float w = vte_cntl.vtx_w0_fmt ? p[3] : 1.0f / p[3];
+    float z = vte_cntl.vtx_z_fmt ? p[2] * w : p[2];
+    // Anything that could be clipped makes the coverage unknown.
+    if (!(w > 0.0f) || (!clip_disable && !(z >= 0.0f && z <= w))) {
+      return 0;
+    }
+    float x = p[0];
+    float y = p[1];
+    if (!vte_cntl.vtx_xy_fmt) {
+      x /= w;
+      y /= w;
+    }
+    if (vte_cntl.vport_x_scale_ena) {
+      x *= reg_float(XE_GPU_REG_PA_CL_VPORT_XSCALE);
+    }
+    if (vte_cntl.vport_x_offset_ena) {
+      x += reg_float(XE_GPU_REG_PA_CL_VPORT_XOFFSET);
+    }
+    if (vte_cntl.vport_y_scale_ena) {
+      y *= reg_float(XE_GPU_REG_PA_CL_VPORT_YSCALE);
+    }
+    if (vte_cntl.vport_y_offset_ena) {
+      y += reg_float(XE_GPU_REG_PA_CL_VPORT_YOFFSET);
+    }
+    if (!std::isfinite(x) || !std::isfinite(y)) {
+      return 0;
+    }
+    {
+      // The depth the host gets (nhl_rt_clear_through_depth): viewport-transformed, only
+      // trusted when the viewport scale / offset are plain registers.
+      float zn = z / w;
+      if (vte_cntl.vport_z_scale_ena) {
+        zn *= reg_float(XE_GPU_REG_PA_CL_VPORT_ZSCALE);
+      }
+      if (vte_cntl.vport_z_offset_ena) {
+        zn += reg_float(XE_GPU_REG_PA_CL_VPORT_ZOFFSET);
+      }
+      z_final[i] = zn;
+    }
+    x_fixed[i] = ui::FloatToD3D11Fixed16p8(x + half_pixel_offset);
+    y_fixed[i] = ui::FloatToD3D11Fixed16p8(y + half_pixel_offset);
+  }
+  // The rectangle covers the bounding box of the vertices only if they are three distinct
+  // corners of an axis-aligned rectangle.
+  int32_t x0 = std::min({x_fixed[0], x_fixed[1], x_fixed[2]});
+  int32_t x1 = std::max({x_fixed[0], x_fixed[1], x_fixed[2]});
+  int32_t y0 = std::min({y_fixed[0], y_fixed[1], y_fixed[2]});
+  int32_t y1 = std::max({y_fixed[0], y_fixed[1], y_fixed[2]});
+  for (uint32_t i = 0; i < 3; ++i) {
+    if ((x_fixed[i] != x0 && x_fixed[i] != x1) || (y_fixed[i] != y0 && y_fixed[i] != y1)) {
+      return 0;
+    }
+    for (uint32_t j = 0; j < i; ++j) {
+      if (x_fixed[i] == x_fixed[j] && y_fixed[i] == y_fixed[j]) {
+        return 0;
+      }
+    }
+  }
+  if (surface_info.msaa_samples == xenos::MsaaSamples::k1X) {
+    // Pixel centers inside according to the top-left rule.
+    x0 = (x0 + 127) >> 8;
+    y0 = (y0 + 127) >> 8;
+    x1 = (x1 + 127) >> 8;
+    y1 = (y1 + 127) >> 8;
+  } else {
+    // Only pixels entirely inside have all their samples covered.
+    x0 = (x0 + 255) >> 8;
+    y0 = (y0 + 255) >> 8;
+    x1 >>= 8;
+    y1 >>= 8;
+  }
+  if (sc_mode_cntl.vtx_window_offset_enable) {
+    auto window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+    x0 += window_offset.window_x_offset;
+    y0 += window_offset.window_y_offset;
+    x1 += window_offset.window_x_offset;
+    y1 += window_offset.window_y_offset;
+  }
+  draw_util::Scissor scissor;
+  draw_util::GetScissor(regs, scissor, false);
+  x0 = std::clamp(x0, int32_t(scissor.offset[0]), int32_t(scissor.offset[0] + scissor.extent[0]));
+  x1 = std::clamp(x1, int32_t(scissor.offset[0]), int32_t(scissor.offset[0] + scissor.extent[0]));
+  y0 = std::clamp(y0, int32_t(scissor.offset[1]), int32_t(scissor.offset[1] + scissor.extent[1]));
+  y1 = std::clamp(y1, int32_t(scissor.offset[1]), int32_t(scissor.offset[1] + scissor.extent[1]));
+  if (x0 < 0 || y0 < 0 || x0 >= x1 || y0 >= y1) {
+    return 0;
+  }
+  nhl_overwrite_z_ = (z_final[0] == z_final[1] && z_final[1] == z_final[2])
+                         ? z_final[0]
+                         : std::numeric_limits<float>::quiet_NaN();
+  rectangle_out.x_pixels = uint32_t(x0);
+  rectangle_out.y_pixels = uint32_t(y0);
+  rectangle_out.width_pixels = uint32_t(x1 - x0);
+  rectangle_out.height_pixels = uint32_t(y1 - y0);
+  return overwritten;
+}
