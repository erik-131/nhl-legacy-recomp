+void VulkanTextureCache::SoftenDepthShadowLevel0(VulkanTexture& texture, uint32_t level0_width,
+                                                 uint32_t level0_height, int passes) {
+  if (passes <= 0 || level0_width < 2 || level0_height < 2) {
+    return;
+  }
+  // Probe once whether R32_SFLOAT can be blit-filtered linearly on this device.
+  if (shadow_blur_linear_filter_ < 0) {
+    const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+    const ui::vulkan::VulkanInstance::Functions& ifn =
+        vulkan_device->vulkan_instance()->functions();
+    VkFormatProperties format_properties;
+    ifn.vkGetPhysicalDeviceFormatProperties(vulkan_device->physical_device(),
+                                             VK_FORMAT_R32_SFLOAT, &format_properties);
+    const VkFormatFeatureFlags features = format_properties.optimalTilingFeatures;
+    // Blit both ways is required; linear filtering is preferred but optional.
+    if (!(features & VK_FORMAT_FEATURE_BLIT_SRC_BIT) ||
+        !(features & VK_FORMAT_FEATURE_BLIT_DST_BIT)) {
+      shadow_blur_linear_filter_ = -2;  // Blit unsupported -> feature disabled.
+      REXGPU_WARN("Shadow softening disabled: R32_SFLOAT is not blittable on this device");
+    } else {
+      shadow_blur_linear_filter_ =
+          (features & VK_FORMAT_FEATURE_SAMPLED_IMAGE_FILTER_LINEAR_BIT) ? 1 : 0;
+    }
+  }
+  if (shadow_blur_linear_filter_ == -2) {
+    return;
+  }
+  const uint32_t half_width = std::max(level0_width >> 1, UINT32_C(1));
+  const uint32_t half_height = std::max(level0_height >> 1, UINT32_C(1));
+  if (!EnsureShadowBlurScratch(half_width, half_height)) {
+    return;
+  }
+  const VkFilter filter =
+      shadow_blur_linear_filter_ == 1 ? VK_FILTER_LINEAR : VK_FILTER_NEAREST;
+  const VkImage shadow_image = texture.image();
+  const VkImageSubresourceRange level0_range =
+      ui::vulkan::util::InitializeSubresourceRange(VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1);
+  const VkImageSubresourceRange scratch_range =
+      ui::vulkan::util::InitializeSubresourceRange(VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1);
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+
+  VkImageBlit down_blit = {};
+  down_blit.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  down_blit.srcOffsets[1] = {int32_t(level0_width), int32_t(level0_height), 1};
+  down_blit.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  down_blit.dstOffsets[1] = {int32_t(half_width), int32_t(half_height), 1};
+  VkImageBlit up_blit = {};
+  up_blit.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  up_blit.srcOffsets[1] = {int32_t(half_width), int32_t(half_height), 1};
+  up_blit.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  up_blit.dstOffsets[1] = {int32_t(level0_width), int32_t(level0_height), 1};
+
+  // The texture's level 0 arrives (and must leave) in TRANSFER_DST_OPTIMAL, which
+  // matches the cache's tracked kTransferDestination usage. Each pass does a
+  // downsample (level0 -> half-res scratch) then an upsample (scratch -> level0).
+  for (int pass = 0; pass < passes; ++pass) {
+    // level0 -> TRANSFER_SRC (read), scratch -> TRANSFER_DST (write, discard old).
+    command_processor_.PushImageMemoryBarrier(
+        shadow_image, level0_range, VK_PIPELINE_STAGE_TRANSFER_BIT,
+        VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    command_processor_.PushImageMemoryBarrier(
+        shadow_blur_scratch_image_, scratch_range, VK_PIPELINE_STAGE_TRANSFER_BIT,
+        VK_PIPELINE_STAGE_TRANSFER_BIT, 0, VK_ACCESS_TRANSFER_WRITE_BIT,
+        VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    command_processor_.SubmitBarriers(true);
+    command_buffer.CmdVkBlitImage(shadow_image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                                  shadow_blur_scratch_image_,
+                                  VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &down_blit, filter);
+
+    // scratch -> TRANSFER_SRC (read), level0 -> TRANSFER_DST (write).
+    command_processor_.PushImageMemoryBarrier(
+        shadow_blur_scratch_image_, scratch_range, VK_PIPELINE_STAGE_TRANSFER_BIT,
+        VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT,
+        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    command_processor_.PushImageMemoryBarrier(
+        shadow_image, level0_range, VK_PIPELINE_STAGE_TRANSFER_BIT,
+        VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_READ_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+        VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    command_processor_.SubmitBarriers(true);
+    command_buffer.CmdVkBlitImage(shadow_blur_scratch_image_,
+                                  VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, shadow_image,
+                                  VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &up_blit, filter);
+  }
+}
