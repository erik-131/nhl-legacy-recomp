From 1053b716693e9e354c133aa90fb0da520ec757d7 Mon Sep 17 00:00:00 2001
From: nhl <nhl@localhost>
Date: Sat, 31 Oct 2026 01:05:00 +0100
Subject: [PATCH] NHL: REX_ALERTABLE_POLL_MS - configurable alertable-wait APC
 poll slice (default 1 ms)

---
 src/core/threading_posix.cpp | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/core/threading_posix.cpp b/src/core/threading_posix.cpp
index 9ac8d15..a6915a4 100644
--- a/src/core/threading_posix.cpp
+++ b/src/core/threading_posix.cpp
@@ -6,6 +6,7 @@
  * @license     BSD 3-Clause License
  */
 
+#include <cstdlib>
 #include <rex/platform.h>
 #include <rex/thread.h>
 
@@ -1070,7 +1071,14 @@ bool DispatchCurrentThreadUserCallback() {
 
 namespace {
 
-constexpr auto kAlertablePollSlice = std::chrono::milliseconds(1);
+// NHL: REX_ALERTABLE_POLL_MS (default 1). Alertable waits wake every slice to look for queued
+// APCs (the delivery signal does not interrupt a condition-variable wait); with many guest
+// threads in alertable waits that polling costs real CPU - and on an iGPU, package power.
+const std::chrono::milliseconds kAlertablePollSlice = [] {
+  const char* e = std::getenv("REX_ALERTABLE_POLL_MS");
+  const long v = (e && *e) ? std::strtol(e, nullptr, 10) : 1;
+  return std::chrono::milliseconds(v < 1 ? 1 : (v > 50 ? 50 : v));
+}();
 
 class ScopedAlertableState {
  public:
-- 
