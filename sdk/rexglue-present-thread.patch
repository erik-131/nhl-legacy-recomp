 #include <atomic>
 #include <cctype>
 #include <utility>
@@ -287,6 +288,8 @@ Presenter::~Presenter() {
   // it if needed.
   assert_false(is_executing_ui_drawers_);
 
+  StopPresentThread();
+
 #if REX_PLATFORM_WIN32
   if (dxgi_ui_tick_thread_.joinable()) {
     {
@@ -614,6 +617,10 @@ bool Presenter::RefreshGuestOutput(
   }
 
   // Trigger the presentation on the host.
+  static const bool present_thread_enabled = [] {
+    const char* e = std::getenv("REX_PRESENT_THREAD");
+    return e && *e && *e != '0';
+  }();
   PaintResult paint_result = PaintResult::kNotPresented;
   {
     std::lock_guard<std::mutex> paint_mode_mutex_lock(paint_mode_mutex_);
@@ -627,7 +634,11 @@ bool Presenter::RefreshGuestOutput(
         break;
       case PaintMode::kGuestOutputThreadImmediately:
         // Both painting and window paint requesting are accessible.
-        if (surface_paint_connection_state_ == SurfacePaintConnectionState::kConnectedPaintable) {
+        if (present_thread_enabled) {
+          // NHL: hand the paint to the present thread (see PresentThreadMain).
+          SignalPresentThread();
+        } else if (surface_paint_connection_state_ ==
+                   SurfacePaintConnectionState::kConnectedPaintable) {
           paint_result = PaintAndPresent(false);
           if (surface_paint_connection_state_ == SurfacePaintConnectionState::kConnectedOutdated) {
             RequestPaintOrConnectionRecoveryViaWindow(true);
@@ -649,6 +660,67 @@ bool Presenter::RefreshGuestOutput(
   return is_active;
 }
 
+void Presenter::SignalPresentThread() {
+  {
+    std::lock_guard<std::mutex> lock(present_thread_mutex_);
+    if (present_thread_shutdown_) {
+      return;
+    }
+    if (!present_thread_.joinable()) {
+      present_thread_ = std::thread([this] { PresentThreadMain(); });
+    }
+    present_thread_pending_ = true;
+  }
+  present_thread_cv_.notify_one();
+}
+
+void Presenter::StopPresentThread() {
+  {
+    std::lock_guard<std::mutex> lock(present_thread_mutex_);
+    present_thread_shutdown_ = true;
+  }
+  present_thread_cv_.notify_one();
+  if (present_thread_.joinable()) {
+    present_thread_.join();
+  }
+}
+
+void Presenter::PresentThreadMain() {
+  for (;;) {
+    {
+      std::unique_lock<std::mutex> lock(present_thread_mutex_);
+      present_thread_cv_.wait(lock, [this] { return present_thread_pending_ || present_thread_shutdown_; });
+      if (present_thread_shutdown_) {
+        return;
+      }
+      // Frames signalled while painting collapse into one paint of the latest image.
+      present_thread_pending_ = false;
+    }
+    PaintResult paint_result = PaintResult::kNotPresented;
+    {
+      // Same protocol as the guest output thread painting immediately: the UI thread
+      // changes the mode and the connection only under this mutex.
+      std::lock_guard<std::mutex> paint_mode_mutex_lock(paint_mode_mutex_);
+      if (paint_mode_ == PaintMode::kGuestOutputThreadImmediately &&
+          surface_paint_connection_state_ == SurfacePaintConnectionState::kConnectedPaintable) {
+        paint_result = PaintAndPresent(false);
+        if (surface_paint_connection_state_ == SurfacePaintConnectionState::kConnectedOutdated) {
+          RequestPaintOrConnectionRecoveryViaWindow(true);
+        }
+      } else if (paint_mode_ == PaintMode::kUIThreadOnRequest) {
+        RequestPaintOrConnectionRecoveryViaWindow(true);
+      }
+    }
+    if (host_gpu_loss_callback_) {
+      if (paint_result == PaintResult::kGpuLostResponsible) {
+        host_gpu_loss_callback_(true, false);
+      } else if (paint_result == PaintResult::kGpuLostExternally) {
+        host_gpu_loss_callback_(false, false);
+      }
+    }
+  }
+}
+
