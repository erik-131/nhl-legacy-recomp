Subject: [PATCH] NHL: optional dedicated present thread (REX_PRESENT_THREAD=1)

---
 include/rex/ui/presenter.h         | 13 ++++++
 src/ui/presenter.cpp               | 74 +++++++++++++++++++++++++++++-
 src/ui/vulkan/vulkan_presenter.cpp |  2 +
 3 files changed, 88 insertions(+), 1 deletion(-)

diff --git a/include/rex/ui/presenter.h b/include/rex/ui/presenter.h
index afb4a30..873b25b 100644
--- a/include/rex/ui/presenter.h
+++ b/include/rex/ui/presenter.h
@@ -326,6 +326,9 @@ class Presenter {
   Presenter(const Presenter& presenter) = delete;
   Presenter& operator=(const Presenter& presenter) = delete;
   virtual ~Presenter();
+  // Stops the NHL present thread; derived presenters call it before destroying their
+  // painting resources. Idempotent.
+  void StopPresentThread();
 
   virtual Surface::TypeFlags GetSupportedSurfaceTypes() const = 0;
 
@@ -891,6 +894,16 @@ class Presenter {
   // On the other hand, the guest output thread _must_ hold it all the time it's
   // painting, to ensure the mode stays the same while it's painting.
   std::mutex paint_mode_mutex_;
+  // NHL: REX_PRESENT_THREAD=1 - in kGuestOutputThreadImmediately mode, the guest output
+  // thread only signals this thread, which paints and presents (keeps the host present and
+  // its GPU waits off the GPU command processor thread).
+  void PresentThreadMain();
+  void SignalPresentThread();
+  std::thread present_thread_;
+  std::mutex present_thread_mutex_;
+  std::condition_variable present_thread_cv_;
+  bool present_thread_pending_ = false;
+  bool present_thread_shutdown_ = false;
   // UI thread: writable, guest output thread: read-only.
   PaintMode paint_mode_ = PaintMode::kNone;
 
