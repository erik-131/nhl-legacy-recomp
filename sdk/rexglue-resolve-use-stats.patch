From 5c2cfb9b2e5fa557e2ac53863dcff2f50273d131 Mon Sep 17 00:00:00 2001
From: nhl <nhl@localhost>
Date: Sat, 31 Oct 2026 00:04:25 +0100
Subject: [PATCH] NHL diag: [nhl-resuse] resolve destination texture-use stats
 (NHL_RESOLVE_USE_STATS)

---
 include/rex/graphics/pipeline/texture/cache.h |  4 +
 src/graphics/pipeline/texture/cache.cpp       | 82 +++++++++++++++++++
 src/graphics/vulkan/command_processor.cpp     |  3 +
 3 files changed, 89 insertions(+)

diff --git a/include/rex/graphics/pipeline/texture/cache.h b/include/rex/graphics/pipeline/texture/cache.h
index d26cd4f..bdb53ce 100644
--- a/include/rex/graphics/pipeline/texture/cache.h
+++ b/include/rex/graphics/pipeline/texture/cache.h
@@ -111,6 +111,10 @@ class TextureCache {
 
   virtual void RequestTextures(uint32_t used_texture_mask);
 
+  // NHL diag (NHL_RESOLVE_USE_STATS=1): per resolve destination, how often a texture fetch
+  // of a later draw reads it before the next resolve overwrites it. [nhl-resuse]
+  void NhlNoteResolve(uint32_t address, uint32_t length);
+
   // "ActiveTexture" means as of the latest RequestTextures call.
 
   uint32_t GetActiveTextureHostSwizzle(uint32_t fetch_constant_index) const {
diff --git a/src/graphics/pipeline/texture/cache.cpp b/src/graphics/pipeline/texture/cache.cpp
index 76f5600..22e6419 100644
--- a/src/graphics/pipeline/texture/cache.cpp
+++ b/src/graphics/pipeline/texture/cache.cpp
@@ -10,7 +10,10 @@
  */
 
 #include <algorithm>
+#include <chrono>
 #include <cstdint>
+#include <cstdlib>
+#include <map>
 #include <utility>
 
 #include <rex/assert.h>
@@ -450,9 +453,88 @@ bool TextureCache::CommitPreparedTextureLoad(const PendingTextureLoad& pending_l
   return true;
 }
 
+namespace {
+struct NhlResolveUse {
+  uint32_t length = 0;
+  uint64_t resolves = 0;          // resolves into this destination
+  uint64_t sampled_fetches = 0;   // draw texture fetches overlapping it
+  uint64_t dead = 0;              // resolves overwritten by the next one with no fetch between
+  bool used_since_resolve = false;
+};
+bool NhlResolveUseStatsEnabled() {
+  static const bool on = std::getenv("NHL_RESOLVE_USE_STATS") != nullptr;
+  return on;
+}
+std::map<uint32_t, NhlResolveUse>& NhlResolveUses() {
+  static std::map<uint32_t, NhlResolveUse> uses;
+  return uses;
+}
+void NhlResolveUseMaybeLog() {
+  static auto window_start = std::chrono::steady_clock::now();
+  const auto now = std::chrono::steady_clock::now();
+  if (now - window_start < std::chrono::seconds(1)) {
+    return;
+  }
+  window_start = now;
+  std::string line;
+  for (auto& [address, use] : NhlResolveUses()) {
+    if (!use.resolves) {
+      continue;
+    }
+    line += fmt::format(" {:08X}+{:X}:r{}/f{}/dead{}", address, use.length, use.resolves,
+                        use.sampled_fetches, use.dead);
+    use.resolves = use.sampled_fetches = use.dead = 0;
+  }
+  REXGPU_INFO("[nhl-resuse] 1s{}", line);
+}
+}  // namespace
+
+void TextureCache::NhlNoteResolve(uint32_t address, uint32_t length) {
+  if (!NhlResolveUseStatsEnabled() || !length) {
+    return;
+  }
+  address &= 0x1FFFFFFF;
+  NhlResolveUse& use = NhlResolveUses()[address];
+  if (use.resolves && !use.used_since_resolve) {
+    ++use.dead;
+  }
+  use.length = std::max(use.length, length);
+  ++use.resolves;
+  use.used_since_resolve = false;
+  NhlResolveUseMaybeLog();
+}
+
 void TextureCache::RequestTextures(uint32_t used_texture_mask) {
   const auto& regs = register_file();
 
+  if (NhlResolveUseStatsEnabled() && !NhlResolveUses().empty()) {
+    uint32_t mask = used_texture_mask;
+    uint32_t fetch_index;
+    while (rex::bit_scan_forward(mask, &fetch_index)) {
+      mask &= ~(UINT32_C(1) << fetch_index);
+      xenos::xe_gpu_texture_fetch_t fetch = regs.GetTextureFetch(fetch_index);
+      const uint32_t pages[2] = {uint32_t(fetch.base_address) << 12,
+                                 uint32_t(fetch.mip_address) << 12};
+      for (uint32_t page : pages) {
+        if (!page) {
+          continue;
+        }
+        // Resolve destinations are few (~10); a texture overlapping one starts inside it
+        // or at its base.
+        auto& uses = NhlResolveUses();
+        auto it = uses.upper_bound(page);
+        if (it == uses.begin()) {
+          continue;
+        }
+        --it;
+        if (page < it->first + it->second.length) {
+          ++it->second.sampled_fetches;
+          it->second.used_since_resolve = true;
+        }
+      }
+    }
+  }
+
   if (texture_became_outdated_.exchange(false, std::memory_order_acquire)) {
     // A texture has become outdated - make sure whether textures are outdated
     // is rechecked in this draw and in subsequent ones to reload the new data
diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index c92b1db..707cd6f 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -4782,6 +4782,9 @@ bool VulkanCommandProcessor::IssueCopy_ReadbackResolvePath() {
   const bool nhl_resolve_ok = render_target_cache_->Resolve(*memory_, *shared_memory_,
                                                             *texture_cache_, written_address,
                                                             written_length);
+  if (nhl_resolve_ok && written_length) {
+    texture_cache_->NhlNoteResolve(written_address, written_length);
+  }
   if (nhl_reslog_state == 0 && NhlResLogTimeReached()) nhl_reslog_state = 1;
   const uint32_t nhl_res_idx = nhl_reslog_index;
   if (nhl_reslog_state == 2) {
-- 
