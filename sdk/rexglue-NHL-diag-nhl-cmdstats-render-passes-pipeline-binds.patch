From 53e9f4bde8e81bcf8bf75b6f1b84f9d57af47a73 Mon Sep 17 00:00:00 2001
From: nhl <nhl@localhost>
Date: Sat, 31 Oct 2026 02:28:31 +0100
Subject: [PATCH] NHL diag: [nhl-cmdstats] render passes / pipeline binds /
 barriers per frame (REX_CMD_STATS)

---
 .../graphics/vulkan/deferred_command_buffer.h   |  5 +++++
 src/graphics/vulkan/command_processor.cpp       | 17 +++++++++++++++++
 src/graphics/vulkan/deferred_command_buffer.cpp |  3 +++
 3 files changed, 25 insertions(+)

diff --git a/include/rex/graphics/vulkan/deferred_command_buffer.h b/include/rex/graphics/vulkan/deferred_command_buffer.h
index 4df6390..ac06295 100644
--- a/include/rex/graphics/vulkan/deferred_command_buffer.h
+++ b/include/rex/graphics/vulkan/deferred_command_buffer.h
@@ -10,6 +10,7 @@
  * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
  */
 
+#include <atomic>
 #include <cstddef>
 #include <cstdint>
 #include <cstring>
@@ -25,6 +26,9 @@ class VulkanCommandProcessor;
 
 class DeferredCommandBuffer {
  public:
+  // NHL diag [nhl-cmdstats]: render pass/rendering begins, pipeline binds, pipeline barriers
+  // recorded (cumulative; the command processor logs per-second deltas).
+  static inline std::atomic<uint64_t> nhl_stats_[3] = {};
   DeferredCommandBuffer(const VulkanCommandProcessor& command_processor,
                         size_t initial_size_bytes = 1024 * 1024);
 
@@ -95,6 +99,7 @@ class DeferredCommandBuffer {
   }
 
   void CmdVkBindPipeline(VkPipelineBindPoint pipeline_bind_point, VkPipeline pipeline) {
+    ++nhl_stats_[1];
     auto& args = *reinterpret_cast<ArgsVkBindPipeline*>(
         WriteCommand(Command::kVkBindPipeline, sizeof(ArgsVkBindPipeline)));
     args.pipeline_bind_point = pipeline_bind_point;
diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index 86ef64a..241b588 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -2347,6 +2347,23 @@ void VulkanCommandProcessor::IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontb
   }
   NhlGpuMark(kNhlGpuSwap);
   NhlResLogOnSwap();
+  // [nhl-cmdstats] once per second: per-frame render pass begins, pipeline binds, barriers.
+  if (static const bool cmdstats = std::getenv("REX_CMD_STATS") != nullptr; cmdstats) {
+    static uint64_t frames = 0, last[3] = {};
+    static auto t0 = std::chrono::steady_clock::now();
+    ++frames;
+    const auto now = std::chrono::steady_clock::now();
+    if (now - t0 >= std::chrono::seconds(1)) {
+      uint64_t cur[3];
+      for (int i = 0; i < 3; ++i) cur[i] = DeferredCommandBuffer::nhl_stats_[i].load();
+      REXGPU_INFO("[nhl-cmdstats] per frame: render_passes={:.1f} pipeline_binds={:.1f} barriers={:.1f}",
+                  double(cur[0] - last[0]) / frames, double(cur[1] - last[1]) / frames,
+                  double(cur[2] - last[2]) / frames);
+      std::memcpy(last, cur, sizeof(last));
+      frames = 0;
+      t0 = now;
+    }
+  }
 
   bool skip_present_due_async_placeholder = REXCVAR_GET(async_shader_compilation) &&
                                             REXCVAR_GET(vulkan_async_skip_incomplete_frames) &&
diff --git a/src/graphics/vulkan/deferred_command_buffer.cpp b/src/graphics/vulkan/deferred_command_buffer.cpp
index 42cb128..e801703 100644
--- a/src/graphics/vulkan/deferred_command_buffer.cpp
+++ b/src/graphics/vulkan/deferred_command_buffer.cpp
@@ -48,6 +48,7 @@ void DeferredCommandBuffer::Execute(VkCommandBuffer command_buffer) {
 
     switch (header.command) {
       case Command::kVkBeginRenderPass: {
+        ++nhl_stats_[0];
         auto& args = *reinterpret_cast<const ArgsVkBeginRenderPass*>(stream);
         size_t offset_bytes = sizeof(ArgsVkBeginRenderPass);
         VkRenderPassBeginInfo render_pass_begin_info;
@@ -207,6 +208,7 @@ void DeferredCommandBuffer::Execute(VkCommandBuffer command_buffer) {
         break;
 
       case Command::kVkBeginRendering: {
+        ++nhl_stats_[0];
         auto& args = *reinterpret_cast<const ArgsVkBeginRendering*>(stream);
         size_t offset_bytes =
             rex::align(sizeof(ArgsVkBeginRendering), alignof(VkRenderingAttachmentInfo));
@@ -246,6 +248,7 @@ void DeferredCommandBuffer::Execute(VkCommandBuffer command_buffer) {
         break;
 
       case Command::kVkPipelineBarrier: {
+        ++nhl_stats_[2];
         auto& args = *reinterpret_cast<const ArgsVkPipelineBarrier*>(stream);
         size_t barrier_offset_bytes = sizeof(ArgsVkPipelineBarrier);
         const VkMemoryBarrier* memory_barriers = nullptr;
-- 
2.47.3

