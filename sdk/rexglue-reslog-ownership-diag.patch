From af01dfe4697c54ac31b08bb6d4952789129dd569 Mon Sep 17 00:00:00 2001
From: nhl <nhl@localhost>
Date: Fri, 30 Oct 2026 15:16:35 +0100
Subject: [PATCH] NHL diag: [nhl-resdump] resolve dump RTs, [nhl-own] ownership
 changes, RT keys per draw run

---
 .../graphics/pipeline/render_target/cache.h   |  3 ++
 .../rex/graphics/vulkan/render_target_cache.h | 10 +++++++
 src/graphics/pipeline/render_target/cache.cpp |  6 ++++
 src/graphics/vulkan/command_processor.cpp     | 18 ++++++++----
 src/graphics/vulkan/render_target_cache.cpp   | 28 +++++++++++++++++++
 5 files changed, 60 insertions(+), 5 deletions(-)

diff --git a/include/rex/graphics/pipeline/render_target/cache.h b/include/rex/graphics/pipeline/render_target/cache.h
index 3bbd52e..eea756a 100644
--- a/include/rex/graphics/pipeline/render_target/cache.h
+++ b/include/rex/graphics/pipeline/render_target/cache.h
@@ -180,6 +180,9 @@ class RenderTargetCache {
   // each.
   uint32_t GetLastUpdateBoundRenderTargets(uint32_t* depth_and_color_formats_out = nullptr) const;
 
+  // NHL diag (REX_RESOLVE_LOG_AT): log every EDRAM ownership change. [nhl-own]
+  bool nhl_log_ownership = false;
+
  protected:
   RenderTargetCache(const RegisterFile& register_file, const memory::Memory& memory,
                     uint32_t draw_resolution_scale_x, uint32_t draw_resolution_scale_y)
diff --git a/include/rex/graphics/vulkan/render_target_cache.h b/include/rex/graphics/vulkan/render_target_cache.h
index 1924acf..ec1fe29 100644
--- a/include/rex/graphics/vulkan/render_target_cache.h
+++ b/include/rex/graphics/vulkan/render_target_cache.h
@@ -114,6 +114,16 @@ class VulkanRenderTargetCache final : public RenderTargetCache {
               uint32_t normalized_color_mask, const Shader& vertex_shader) override;
   // Binding information for the last successful update.
   RenderPassKey last_update_render_pass_key() const { return last_update_render_pass_key_; }
+  // NHL diag (REX_RESOLVE_LOG_AT): log the host render targets each resolve dumps.
+  bool nhl_log_dump = false;
+  // NHL diag: keys of the bound host depth and color 0 render targets (0 if none).
+  void NhlGetBoundKeys(uint32_t& depth_key, uint32_t& color0_key) const {
+    depth_key = color0_key = 0;
+    if (GetPath() != Path::kHostRenderTargets) return;
+    RenderTarget* const* rts = last_update_accumulated_render_targets();
+    if (rts[0]) depth_key = rts[0]->key().key;
+    if (rts[1]) color0_key = rts[1]->key().key;
+  }
   VkRenderPass last_update_render_pass() const { return last_update_render_pass_; }
   const Framebuffer* last_update_framebuffer() const { return last_update_framebuffer_; }
   void GetLastUpdateRenderingAttachments(VkRenderingAttachmentInfo* color_attachments,
diff --git a/src/graphics/pipeline/render_target/cache.cpp b/src/graphics/pipeline/render_target/cache.cpp
index 953c5fd..b6f2cbf 100644
--- a/src/graphics/pipeline/render_target/cache.cpp
+++ b/src/graphics/pipeline/render_target/cache.cpp
@@ -1343,6 +1343,12 @@ void RenderTargetCache::ChangeOwnership(RenderTargetKey dest, uint32_t start_til
         }
       }
       // Claim the current range.
+      if (nhl_log_ownership) {
+        REXGPU_INFO("[nhl-own] [{},{}) {:08X} -> {:08X} (req base+{} len {}{})", it->first,
+                    it->second.end_tiles, it->second.render_target.key, dest.key,
+                    start_tiles_base_relative, length_tiles,
+                    resolve_clear_cutout ? " resolve-clear" : "");
+      }
       it->second.render_target = dest;
       if (host_depth_encoding_different) {
         it->second.GetHostDepthRenderTarget(dest.GetDepthFormat()) = dest;
diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index 5633049..d8220f6 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -4123,6 +4123,7 @@ bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t
   const VulkanPipelineCache::PipelineLayoutProvider* pipeline_layout_provider;
   NhlGpuMark(kNhlGpuRt);
   // Set up the render targets - this may perform dispatches and draws.
+  render_target_cache_->nhl_log_ownership = nhl_reslog_state == 2;
   if (!render_target_cache_->Update(is_rasterization_done, normalized_depth_control,
                                     normalized_color_mask, *vertex_shader)) {
     return draw_fail("render_target_update");
@@ -4399,7 +4400,9 @@ bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t
   ++nhl_reslog_draws;
   if (nhl_reslog_state == 2) {
     const RegisterFile& r = *register_file_;
-    const uint32_t t[9] = {render_target_cache_->last_update_render_pass_key().key,
+    uint32_t nhl_rt_depth, nhl_rt_color0;
+    render_target_cache_->NhlGetBoundKeys(nhl_rt_depth, nhl_rt_color0);
+    const uint32_t t[11] = {render_target_cache_->last_update_render_pass_key().key,
                            r.values[XE_GPU_REG_RB_SURFACE_INFO],
                            r.values[XE_GPU_REG_RB_COLOR_INFO],
                            r.values[XE_GPU_REG_RB_DEPTH_INFO],
@@ -4407,15 +4410,18 @@ bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t
                            r.values[XE_GPU_REG_RB_COLOR_MASK],
                            r.values[XE_GPU_REG_PA_SC_WINDOW_OFFSET],
                            r.values[XE_GPU_REG_PA_SU_SC_MODE_CNTL],
-                           r.values[XE_GPU_REG_RB_MODECONTROL]};
-    static uint32_t last[9] = {};
+                           r.values[XE_GPU_REG_RB_MODECONTROL],
+                           nhl_rt_depth,
+                           nhl_rt_color0};
+    static uint32_t last[11] = {};
     static uint32_t run = 0;
     if (std::memcmp(t, last, sizeof(t)) != 0) {
       if (run) {
         REXGPU_INFO("[nhl-reslog] draws x{} rp={:08X} surf={:08X} c0={:08X} depth={:08X} "
-                    "dctl={:08X} cmask={:08X} win_off={:08X} sc_mode={:08X} modectl={:08X}",
+                    "dctl={:08X} cmask={:08X} win_off={:08X} sc_mode={:08X} modectl={:08X} "
+                    "rt_d={:08X} rt_c0={:08X}",
                     run, last[0], last[1], last[2], last[3], last[4], last[5], last[6], last[7],
-                    last[8]);
+                    last[8], last[9], last[10]);
       }
       std::memcpy(last, t, sizeof(t));
       run = 0;
@@ -4770,6 +4776,8 @@ bool VulkanCommandProcessor::IssueCopy_ReadbackResolvePath() {
   const VkDevice device = vulkan_device->device();
 
   uint32_t written_address, written_length;
+  render_target_cache_->nhl_log_dump = nhl_reslog_state == 2;
+  render_target_cache_->nhl_log_ownership = nhl_reslog_state == 2;
   const bool nhl_resolve_ok = render_target_cache_->Resolve(*memory_, *shared_memory_,
                                                             *texture_cache_, written_address,
                                                             written_length);
diff --git a/src/graphics/vulkan/render_target_cache.cpp b/src/graphics/vulkan/render_target_cache.cpp
index caf232c..a0576b8 100644
--- a/src/graphics/vulkan/render_target_cache.cpp
+++ b/src/graphics/vulkan/render_target_cache.cpp
@@ -1174,6 +1174,34 @@ bool VulkanRenderTargetCache::Resolve(const memory::Memory& memory,
       const draw_util::ResolveCopyShaderInfo& copy_shader_info =
           draw_util::resolve_copy_shader_info[size_t(copy_shader)];
       bool direct_resolved = false;
+      if (GetPath() == Path::kHostRenderTargets && nhl_log_dump) {
+        // [nhl-resdump] which host render targets own the copied EDRAM tiles.
+        uint32_t base, row_len, rows, pitch;
+        resolve_info.GetCopyEdramTileSpan(base, row_len, rows, pitch);
+        std::vector<ResolveCopyDumpRectangle> rects;
+        GetResolveCopyRectanglesToDump(base, row_len, rows, pitch, rects);
+        std::string s;
+        for (const ResolveCopyDumpRectangle& rc : rects) {
+          RenderTargetKey k = rc.render_target->key();
+          s += fmt::format(" [rt={:08X} base={} pitch={} msaa={} depth={} fmt={} rows={}+{} "
+                           "first_start={} last_end={}]",
+                           k.key, uint32_t(k.base_tiles), k.GetPitchTiles(),
+                           uint32_t(k.msaa_samples), uint32_t(k.is_depth),
+                           uint32_t(k.resource_format), rc.row_first, rc.rows, rc.row_first_start,
+                           rc.row_last_end);
+        }
+        REXGPU_INFO("[nhl-resdump] span base={} row_len={} rows={} pitch={} src_base={} "
+                    "src_msaa={} copy_shader={} first_tile_pass={} in_tiled_seq={} rects={}{}",
+                    base, row_len, rows, pitch,
+                    uint32_t(resolve_info.IsCopyingDepth()
+                                 ? resolve_info.depth_edram_info.base_tiles
+                                 : resolve_info.color_edram_info.base_tiles),
+                    uint32_t(resolve_info.IsCopyingDepth()
+                                 ? resolve_info.depth_edram_info.msaa_samples
+                                 : resolve_info.color_edram_info.msaa_samples),
+                    uint32_t(copy_shader), resolve_info.first_tile_pass,
+                    resolve_info.in_tiled_sequence, rects.size(), s);
+      }
       if (GetPath() == Path::kHostRenderTargets) {
         if (REXCVAR_GET(direct_host_resolve)) {
           direct_resolved =
-- 
2.47.3

