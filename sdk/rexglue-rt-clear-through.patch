 .../rex/graphics/vulkan/render_target_cache.h |   8 +
 src/graphics/pipeline/render_target/cache.cpp |  24 +++
 src/graphics/vulkan/command_processor.cpp     |  12 ++
 src/graphics/vulkan/render_target_cache.cpp   | 190 +++++++++++++++++-
 5 files changed, 237 insertions(+), 3 deletions(-)

