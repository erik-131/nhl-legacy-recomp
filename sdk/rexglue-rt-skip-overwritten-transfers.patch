+namespace {
+// [nhl-xfer] (nhl_rt_transfer_stats): ownership transfer volume, logged once per second.
+struct NhlTransferStats {
+  std::chrono::steady_clock::time_point window_start = std::chrono::steady_clock::now();
+  uint64_t calls = 0;
+  uint64_t transfers = 0;
+  uint64_t tiles = 0;
+  // [source MSAA][destination MSAA][destination is depth].
+  uint64_t tiles_by_pair[3][3][2] = {};
+  // Transfers skipped entirely / performed around the area a draw overwrites.
+  uint64_t dropped_tiles = 0;
+  uint64_t cut_tiles = 0;
+};
+NhlTransferStats nhl_transfer_stats;
+
+void NhlTransferStatsMaybeLog() {
+  NhlTransferStats& stats = nhl_transfer_stats;
+  const auto now = std::chrono::steady_clock::now();
+  const double seconds = std::chrono::duration<double>(now - stats.window_start).count();
+  if (seconds < 1.0) {
+    return;
+  }
+  static const char* const kSamples[] = {"1x", "2x", "4x"};
+  std::string pairs;
+  for (uint32_t source = 0; source < 3; ++source) {
+    for (uint32_t dest = 0; dest < 3; ++dest) {
+      for (uint32_t depth = 0; depth < 2; ++depth) {
+        if (stats.tiles_by_pair[source][dest][depth]) {
+          pairs += fmt::format(" {}>{}{}:{}", kSamples[source], kSamples[dest], depth ? "d" : "c",
+                               stats.tiles_by_pair[source][dest][depth]);
+        }
+      }
+    }
+  }
+  REXGPU_INFO("[nhl-xfer] {:.2f}s calls={} transfers={} tiles={} dropped={} cut={} |{}", seconds,
+              stats.calls, stats.transfers, stats.tiles, stats.dropped_tiles, stats.cut_tiles,
+              pairs);
+  stats = NhlTransferStats();
+  stats.window_start = now;
+}
