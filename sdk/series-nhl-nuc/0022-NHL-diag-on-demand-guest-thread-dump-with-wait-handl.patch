     }));
     dispatch_thread_->set_name("Kernel Dispatch");
+    // NHL diag: NHL_STALL_DUMP_FILE=<path> - when that file appears, dump all threads once
+    // and delete it (the bench watchdog touches it on a boot stall).
+    if (const char* dump_file = std::getenv("NHL_STALL_DUMP_FILE"); dump_file && *dump_file) {
+      std::thread([this, path = std::string(dump_file)]() {
+        for (;;) {
+          std::this_thread::sleep_for(std::chrono::seconds(1));
+          std::error_code ec;
+          if (std::filesystem::exists(path, ec)) {
+            NhlDumpThreads();
+            std::filesystem::remove(path, ec);
+          }
+        }
+      }).detach();
+    }
     X_STATUS create_status = dispatch_thread_->Create();
     if (XFAILED(create_status)) {
       dispatch_thread_running_ = false;
@@ -689,6 +704,41 @@ void KernelState::SetExecutableModule(object_ref<UserModule> module) {
   LoadAchievementsData();
 }
 
+void KernelState::NhlDumpThreads() {
+  auto global_lock = global_critical_region_.Acquire();
+  REXSYS_INFO("[nhl-stall] ---- {} threads ----", threads_by_id_.size());
+  for (auto& [id, thread] : threads_by_id_) {
+    if (!thread->is_guest_thread()) {
+      continue;
+    }
+    const uint32_t wait_handle = thread->nhl_wait_handle;
+    std::string chain;
+    if (auto* ts = thread->thread_state()) {
+      // Guest stack back-chain: 0(sp) = caller's sp; this codegen saves LR at caller_sp - 8.
+      uint32_t sp = ts->context()->r1.u32;
+      chain = fmt::format("lr={:08X} sp={:08X}:", uint32_t(ts->context()->lr), sp);
+      for (int i = 0; i < 24 && sp; ++i) {
+        const uint32_t back = memory_->TranslateVirtual<rex::be<uint32_t>*>(sp)[0];
+        if (!back || back <= sp || back - sp > 0x100000) {
+          break;
+        }
+        chain += fmt::format(" {:08X}",
+                             uint32_t(memory_->TranslateVirtual<rex::be<uint32_t>*>(back - 8)[0]));
+        sp = back;
+      }
+    }
+    std::string wait = "running/sleeping";
+    if (wait_handle) {
+      auto obj = object_table()->LookupObject<XObject>(wait_handle);
+      wait = fmt::format("wait handle={:08X} type={} count={} name='{}'", wait_handle,
+                         uint32_t(thread->nhl_wait_type), uint32_t(thread->nhl_wait_count),
+                         obj ? obj->name() : std::string("?"));
+    }
+    REXSYS_INFO("[nhl-stall] tid={} '{}' {} | {}", thread->thread_id(), thread->name(), wait,
+                chain);
+  }
+}
+
 void KernelState::LoadKernelModule(object_ref<KernelModule> kernel_module) {
   auto global_lock = global_critical_region_.Acquire();
   kernel_modules_.push_back(std::move(kernel_module));
