From a0625eaebf8f33bcc667ebcaa30350b89e39a941 Mon Sep 17 00:00:00 2001
From: Erik <erik-131@users.noreply.github.com>
Date: Thu, 5 Nov 2026 21:34:56 +0100
Subject: [PATCH 30/42] NHL: log pipeline compile time and frames not presented
 while pipelines compile

---
 src/graphics/vulkan/command_processor.cpp | 18 ++++++++++++++++++
 src/graphics/vulkan/pipeline_cache.cpp    |  4 ++++
 2 files changed, 22 insertions(+)

diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index 414502f..196589e 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -2395,6 +2395,24 @@ void VulkanCommandProcessor::IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontb
   bool skip_present_due_async_placeholder = REXCVAR_GET(async_shader_compilation) &&
                                             REXCVAR_GET(vulkan_async_skip_incomplete_frames) &&
                                             frame_used_async_placeholder_pipeline_;
+  static uint32_t nhl_skipped_frames = 0;
+  static std::chrono::steady_clock::time_point nhl_skip_start;
+  if (skip_present_due_async_placeholder) {
+    if (!nhl_skipped_frames++) {
+      nhl_skip_start = std::chrono::steady_clock::now();
+    }
+  } else if (nhl_skipped_frames) {
+    REXGPU_INFO("[nhl-skip] {} frames not presented over {:.0f} ms", nhl_skipped_frames,
+                std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - nhl_skip_start)
+                    .count());
+    nhl_skipped_frames = 0;
+  }
+  if (frame_used_async_placeholder_pipeline_ && !skip_present_due_async_placeholder) {
+    static uint64_t nhl_incomplete_frames = 0;
+    if (!(nhl_incomplete_frames++ % 16)) {
+      REXGPU_INFO("[nhl-skip] incomplete frame presented, total {}", nhl_incomplete_frames);
+    }
+  }
   if (skip_present_due_async_placeholder) {
     static bool skipped_incomplete_frame_logged = false;
     if (!skipped_incomplete_frame_logged) {
diff --git a/src/graphics/vulkan/pipeline_cache.cpp b/src/graphics/vulkan/pipeline_cache.cpp
index 7daed99..af718d8 100644
--- a/src/graphics/vulkan/pipeline_cache.cpp
+++ b/src/graphics/vulkan/pipeline_cache.cpp
@@ -3612,6 +3612,7 @@ bool VulkanPipelineCache::EnsurePipelineCreated(const PipelineCreationArguments&
   const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
   const VkDevice device = vulkan_device->device();
   VkPipeline pipeline;
+  const auto nhl_create_start = std::chrono::steady_clock::now();
   VkResult create_result = dfn.vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1,
                                                          &pipeline_create_info, nullptr, &pipeline);
   if (create_result != VK_SUCCESS) {
@@ -3629,6 +3630,9 @@ bool VulkanPipelineCache::EnsurePipelineCreated(const PipelineCreationArguments&
         uint32_t(use_dynamic_rendering));
     return false;
   }
+  REXGPU_INFO("[nhl-pso] {} {:.1f} ms", creating_placeholder ? "placeholder" : "real",
+              std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - nhl_create_start)
+                  .count());
   bool was_placeholder =
       creation_arguments.pipeline->second.is_placeholder.load(std::memory_order_acquire);
   VkPipeline old_pipeline =
-- 
