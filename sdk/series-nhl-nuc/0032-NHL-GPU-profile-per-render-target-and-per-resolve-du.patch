+REXCVAR_DEFINE_BOOL(nhl_fast_vertex_math, false, "GPU",
+                    "Vertex shaders: no 0 * x check where x can't be infinite or NaN");
+
 namespace rex::graphics {
 
+// In a vertex shader without rcp, rsq or log so far, nothing can be infinite or NaN unless the
+// constants or vertex data are, and then 0 * x is 0 anyway, so the Shader Model 3 check is dropped: it
+// costs several instructions per product, and NHL's skinning shaders have hundreds of products per vertex.
+bool SpirvShaderTranslator::NhlSkipMultiplyZeroCheck() const {
+  return is_vertex_shader() && !nhl_infinity_source_seen_ && REXCVAR_GET(nhl_fast_vertex_math);
+}
