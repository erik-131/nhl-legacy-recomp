+// Waits on an object, signalling to_signal (if any) once the wait is registered, without holding
+// the two objects' locks together: two threads signalling each other would deadlock.
+WaitResult WaitAndSignal(PosixConditionBase& condition, PosixConditionBase* to_signal,
+                         bool is_alertable, std::chrono::milliseconds timeout) {
+  struct QueuedWait {
+    PosixConditionBase& condition;
+    PosixEventWaiter waiter;
+    bool enqueued;
+    explicit QueuedWait(PosixConditionBase& c) : condition(c), enqueued(c.Enqueue(&waiter)) {}
+    ~QueuedWait() {
+      if (enqueued) {
+        condition.Dequeue(&waiter);
+      }
+    }
+  } wait(condition);
+
+  if (to_signal && !to_signal->Signal()) {
     return WaitResult::kFailed;
   }
+
   if (!is_alertable) {
-    return posix_wait_handle->condition().Wait(timeout);
+    if (!wait.enqueued) {
+      return condition.Wait(timeout);
+    }
+    auto result = condition.WaitEnqueued(&wait.waiter, timeout);
+    return result == WaitResult::kTimeout && condition.Dequeue(&wait.waiter) ? WaitResult::kSuccess
+                                                                             : result;
   }
 
   ScopedAlertableState alertable_state_guard(true);
   auto deadline = ComputeAlertableDeadline(timeout);
-
   while (true) {
+    if (wait.enqueued) {
+      if (CurrentThreadHasUserCallback()) {
+        if (condition.Dequeue(&wait.waiter)) {
+          return WaitResult::kSuccess;
+        }
+        if (DispatchCurrentThreadUserCallback()) {
+          return WaitResult::kUserCallback;
+        }
+        condition.Enqueue(&wait.waiter);
+      }
+      if (HasAlertableTimeoutElapsed(deadline)) {
+        return condition.Dequeue(&wait.waiter) ? WaitResult::kSuccess : WaitResult::kTimeout;
+      }
+      auto result = condition.WaitEnqueued(&wait.waiter, ComputeAlertableWaitTimeout(deadline));
+      if (result != WaitResult::kTimeout) {
+        return result;
+      }
+      continue;
+    }
     if (DispatchCurrentThreadUserCallback()) {
       return WaitResult::kUserCallback;
     }
     if (HasAlertableTimeoutElapsed(deadline)) {
       return WaitResult::kTimeout;
     }
-    auto result = posix_wait_handle->condition().Wait(ComputeAlertableWaitTimeout(deadline));
+    auto result = condition.Wait(ComputeAlertableWaitTimeout(deadline));
     if (result != WaitResult::kTimeout) {
       return result;
     }
   }
 }
 
+}  // namespace
