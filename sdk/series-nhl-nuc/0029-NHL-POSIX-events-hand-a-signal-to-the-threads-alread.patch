+// A thread queued on an event. Lives on the waiting thread's stack; guarded by the event's mutex.
+struct PosixEventWaiter {
+  PosixEventWaiter* prev = nullptr;
+  PosixEventWaiter* next = nullptr;
+  bool queued = false;
+  bool released = false;
+};
+
 class PosixConditionBase {
  public:
   PosixConditionBase() {
@@ -288,6 +296,17 @@ class PosixConditionBase {
   virtual ~PosixConditionBase() = default;
   virtual bool Signal() = 0;
 
+  // Events hand a signal to the threads waiting when it arrives, like KeSetEvent, so a wait is
+  // registered first: a later arrival can't take the signal, and a reset right after a set doesn't
+  // lose it. false: this object doesn't queue waiters.
+  virtual bool Enqueue(PosixEventWaiter*) { return false; }
+  // Waits for the waiter to be released. On a timeout it stays queued.
+  virtual WaitResult WaitEnqueued(PosixEventWaiter*, std::chrono::milliseconds) {
+    return WaitResult::kFailed;
+  }
+  // Removes the waiter. true: it had already been released, so the wait succeeded.
+  virtual bool Dequeue(PosixEventWaiter*) { return false; }
+
   WaitResult Wait(std::chrono::milliseconds timeout) {
     bool executed;
     auto predicate = [this] { return this->signaled(); };
@@ -449,7 +468,16 @@ class PosixCondition<Event> : public PosixConditionBase {
 
   bool Signal() override {
     auto lock = std::unique_lock<std::mutex>(mutex_);
-    signal_ = true;
+    if (manual_reset_) {
+      signal_ = true;
+      while (waiters_head_) {
+        ReleaseWaiter(waiters_head_);
+      }
+    } else if (waiters_head_) {
+      ReleaseWaiter(waiters_head_);  // Oldest first; the event stays unsignalled.
+    } else {
+      signal_ = true;
+    }
     cond_.notify_all();
     return true;
   }
@@ -459,7 +487,50 @@ class PosixCondition<Event> : public PosixConditionBase {
     signal_ = false;
   }
 
+  bool Enqueue(PosixEventWaiter* waiter) override {
+    auto lock = std::unique_lock<std::mutex>(mutex_);
+    waiter->released = false;
+    if (signal_) {
+      waiter->released = true;
+      post_execution();
+      return true;
+    }
+    waiter->queued = true;
+    waiter->prev = waiters_tail_;
+    waiter->next = nullptr;
+    (waiters_tail_ ? waiters_tail_->next : waiters_head_) = waiter;
+    waiters_tail_ = waiter;
+    return true;
+  }
+
+  WaitResult WaitEnqueued(PosixEventWaiter* waiter, std::chrono::milliseconds timeout) override {
+    auto predicate = [waiter] { return waiter->released; };
+    std::unique_lock<std::mutex> lock(mutex_);
+    if (timeout == std::chrono::milliseconds::max()) {
+      cond_.wait(lock, predicate);
+      return WaitResult::kSuccess;
+    }
+    return cond_.wait_for(lock, timeout, predicate) ? WaitResult::kSuccess : WaitResult::kTimeout;
+  }
+
+  bool Dequeue(PosixEventWaiter* waiter) override {
+    auto lock = std::unique_lock<std::mutex>(mutex_);
+    if (waiter->queued) {
+      Unlink(waiter);
+    }
+    return waiter->released;
+  }
+
  private:
+  void Unlink(PosixEventWaiter* waiter) {
+    (waiter->prev ? waiter->prev->next : waiters_head_) = waiter->next;
+    (waiter->next ? waiter->next->prev : waiters_tail_) = waiter->prev;
+    waiter->queued = false;
+  }
+  void ReleaseWaiter(PosixEventWaiter* waiter) {
+    Unlink(waiter);
+    waiter->released = true;
+  }
   inline bool signaled() const override { return signal_; }
   inline void post_execution() override {
     if (!manual_reset_) {
@@ -468,6 +539,8 @@ class PosixCondition<Event> : public PosixConditionBase {
   }
   bool signal_;
   const bool manual_reset_;
+  PosixEventWaiter* waiters_head_ = nullptr;
+  PosixEventWaiter* waiters_tail_ = nullptr;
 };
 
