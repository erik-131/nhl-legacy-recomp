diff --git a/src/graphics/shaders/fused_resolve/fused_compare.glsl b/src/graphics/shaders/fused_resolve/fused_compare.glsl
new file mode 100644
index 0000000..64a4113
--- /dev/null
+++ b/src/graphics/shaders/fused_resolve/fused_compare.glsl
@@ -0,0 +1,25 @@
+#version 450
+// Verify mode: compares the real resolve destination with the fused one dword by dword.
+layout(local_size_x = 64) in;
+layout(set = 0, binding = 0) readonly buffer A { uint a[]; };
+layout(set = 0, binding = 1) readonly buffer B { uint b[]; };
+layout(set = 1, binding = 0) buffer R { uint r[]; };
+layout(push_constant) uniform P { uint count; uint slot; } pc;
+void main() {
+  uint i = gl_GlobalInvocationID.x;
+  if (i == 0u) {
+    r[pc.slot * 8u + 1u] = 0xC0DE0001u;
+  }
+  if (i >= pc.count) {
+    return;
+  }
+  uint x = a[i], y = b[i];
+  if (x != y) {
+    uint n = atomicAdd(r[pc.slot * 8u], 1u);
+    if (n == 0u) {
+      r[pc.slot * 8u + 2u] = i;
+      r[pc.slot * 8u + 3u] = x;
+      r[pc.slot * 8u + 4u] = y;
+    }
+  }
+}
diff --git a/src/graphics/shaders/fused_resolve/fused_load.glsl b/src/graphics/shaders/fused_resolve/fused_load.glsl
new file mode 100644
index 0000000..bdcce53
--- /dev/null
+++ b/src/graphics/shaders/fused_resolve/fused_load.glsl
@@ -0,0 +1,141 @@
+#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+// Fused resolve: replaces the EDRAM buffer loads of the fast 32bpp resolve copy shaders with direct
+// reads of the host render target image. Defines: FUSED_DEPTH (0/1), FUSED_MSAA (1/2/4 guest samples),
+// FUSED_HOST_MS (1 = multisampled host image).
+layout(local_size_x = 8, local_size_y = 8) in;
+
+#if FUSED_DEPTH
+#if FUSED_HOST_MS
+layout(set = 0, binding = 0) uniform texture2DMS u_src;
+layout(set = 0, binding = 1) uniform utexture2DMS u_stencil;
+#else
+layout(set = 0, binding = 0) uniform texture2D u_src;
+layout(set = 0, binding = 1) uniform utexture2D u_stencil;
+#endif
+#else
+#if FUSED_HOST_MS
+layout(set = 0, binding = 0) uniform texture2DMS u_src;
+#else
+layout(set = 0, binding = 0) uniform texture2D u_src;
+#endif
+#endif
+
+// ex.x = render target base tiles, ex.y = pitch tiles, ex.z = flags:
+// bits 0..3 host sample for guest 2x row 0, bits 4..7 for row 1, bit 8 depth float24 round,
+// bit 9 gamma as unorm16, bit 10 depth is float24 (D24FS8), bits 12..15 colour format
+// (0 8888, 1 8888 gamma, 2 2_10_10_10).
+
+uint PreClampedDepthTo20e4(float d, bool round_even) {
+  uint f = floatBitsToUint(d);
+  uint denorm = bitfieldInsert(f, 1u, 23, 9);
+  uint sh = min(112u - (f >> 23), 24u);
+  denorm = denorm >> sh;
+  uint normal = f - (111u << 23);
+  uint b = (f < 0x38000000u) ? denorm : normal;
+  if (round_even) {
+    b += 3u + bitfieldExtract(b, 3, 1);
+  }
+  return bitfieldExtract(b, 3, 24);
+}
+
+float LinearToPWLGamma(float linear) {
+  bool p3 = linear >= 512.0 / 1023.0;
+  float scale_3_or_2 = p3 ? 1023.0 / 8.0 : 1023.0 / 4.0;
+  float offset_3_or_2 = p3 ? 128.0 / 255.0 : 64.0 / 255.0;
+  bool p1 = linear >= 64.0 / 1023.0;
+  float scale_1_or_0 = p1 ? 1023.0 / 2.0 : 1023.0;
+  float offset_1_or_0 = p1 ? 32.0 / 255.0 : 0.0;
+  bool p2 = linear >= 128.0 / 1023.0;
+  float scale = p2 ? scale_3_or_2 : scale_1_or_0;
+  float offset = p2 ? offset_3_or_2 : offset_1_or_0;
+  return trunc(linear * scale) * (1.0 / 255.0) + offset;
+}
+
+uint FetchPacked(uvec2 s, uint flags) {
+  // s = sample coordinates in the guest sample grid of the render target.
+#if FUSED_MSAA == 4
+  ivec2 pix = ivec2(s >> 1);
+  int smp = int(bitfieldInsert(s.x & 1u, s.y, 1, 1));
+#elif FUSED_MSAA == 2
+  ivec2 pix = ivec2(s.x, s.y >> 1);
+  int smp = int(((s.y & 1u) != 0u) ? ((flags >> 4) & 15u) : (flags & 15u));
+#else
+  ivec2 pix = ivec2(s);
+  int smp = 0;
+#endif
+#if FUSED_HOST_MS
+  ivec2 sz = textureSize(u_src);
+#else
+  ivec2 sz = textureSize(u_src, 0);
+#endif
+  pix = min(pix, sz - 1);
+#if FUSED_HOST_MS
+  vec4 v = texelFetch(u_src, pix, smp);
+#else
+  vec4 v = texelFetch(u_src, pix, 0);
+#endif
+#if FUSED_DEPTH
+#if FUSED_HOST_MS
+  uint st = texelFetch(u_stencil, pix, smp).r;
+#else
+  uint st = texelFetch(u_stencil, pix, 0).r;
+#endif
+  uint p;
+  if ((flags & 1024u) != 0u) {
+    p = PreClampedDepthTo20e4(v.r, (flags & 256u) != 0u);
+  } else {
+    p = uint(roundEven(v.r * 16777215.0));
+  }
+  return bitfieldInsert(st, p, 8, 24);
+#else
+  uint fmt = (flags >> 12) & 15u;
+  if (fmt == 2u) {
+    uint p = uint(v.r * 1023.0 + 0.5);
+    p = bitfieldInsert(p, uint(v.g * 1023.0 + 0.5), 10, 10);
+    p = bitfieldInsert(p, uint(v.b * 1023.0 + 0.5), 20, 10);
+    p = bitfieldInsert(p, uint(v.a * 3.0 + 0.5), 30, 2);
+    return p;
+  }
+  if (fmt == 1u && (flags & 512u) != 0u) {
+    v.r = LinearToPWLGamma(v.r);
+    v.g = LinearToPWLGamma(v.g);
+    v.b = LinearToPWLGamma(v.b);
+  }
+  uint p = uint(v.r * 255.0 + 0.5);
+  p = bitfieldInsert(p, uint(v.g * 255.0 + 0.5), 8, 8);
+  p = bitfieldInsert(p, uint(v.b * 255.0 + 0.5), 16, 8);
+  p = bitfieldInsert(p, uint(v.a * 255.0 + 0.5), 24, 8);
+  return p;
+#endif
+}
+
+uvec4 LoadEdramV4(uint idx, uvec4 ex, uint mask) {
+  uint d0 = idx * 4u;
+  uint tile = d0 / 1280u;
+  uint o = d0 - tile * 1280u;
+  uint y = o / 80u;
+  uint x0 = o - y * 80u;
+  uint rel = (tile - ex.x) & 2047u;
+  uint ty = rel / ex.y;
+  uint tx = rel - ty * ex.y;
+  uvec4 r = uvec4(0u);
+  for (uint k = 0u; k < 4u; ++k) {
+    if (((mask >> k) & 1u) == 0u) {
+      continue;
+    }
+    uint xe = x0 + k;
+#if FUSED_DEPTH
+    uint xt = (xe < 40u) ? xe + 40u : xe - 40u;
+#else
+    uint xt = xe;
+#endif
+    r[k] = FetchPacked(uvec2(80u * tx + xt, 16u * ty + y), ex.z);
+  }
+  return r;
+}
+
+layout(set = 3, binding = 0) buffer Dummy { uvec4 d[]; } u_dummy;
+void main() {
+  u_dummy.d[gl_GlobalInvocationID.x] = LoadEdramV4(gl_GlobalInvocationID.x, uvec4(0), 15u);
+}
diff --git a/src/graphics/shaders/fused_resolve/gen.py b/src/graphics/shaders/fused_resolve/gen.py
new file mode 100644
index 0000000..5c26aee
--- /dev/null
+++ b/src/graphics/shaders/fused_resolve/gen.py
@@ -0,0 +1,135 @@
+#!/usr/bin/env python3
+"""Builds the fused resolve shaders: patches the precompiled fast 32bpp resolve copy shaders so that every
+EDRAM buffer load becomes a call to LoadEdramV4 (fused_load.glsl), which reads the host render target image.
+Usage: gen.py <sdk shader dir> <outdir>. Needs glslangValidator, spirv-as, spirv-dis, spirv-link, spirv-opt, spirv-val."""
+import re, struct, subprocess, sys, os
+sdk, out = sys.argv[1], sys.argv[2]
+here = os.path.dirname(os.path.abspath(__file__))
+os.makedirs(out, exist_ok=True)
+def run(*a, **k):
+    return subprocess.run(a, check=True, capture_output=True, text=True, **k).stdout
+def words(path):
+    t = open(path).read()
+    t = t.split('#endif')[-1] if '#if 0' in t else t
+    return [int(x, 16) for x in re.findall(r'0x[0-9a-fA-F]+', t)]
+def lib_text(depth, msaa, ms):
+    spv = f'{out}/lib.spv'
+    run('glslangValidator', '-V', '--target-env', 'vulkan1.0', '-S', 'comp', f'-DFUSED_DEPTH={depth}',
+        f'-DFUSED_MSAA={msaa}', f'-DFUSED_HOST_MS={ms}', f'{here}/fused_load.glsl', '-o', spv)
+    t = run('spirv-dis', spv)
+    t = re.sub(r'^\s*OpEntryPoint.*\n', '', t, flags=re.M)
+    t = re.sub(r'^\s*OpExecutionMode.*\n', '', t, flags=re.M)
+    t = re.sub(r'^\s*OpDecorate %gl_WorkGroupSize.*\n', '', t, flags=re.M)
+    t = t.replace('OpCapability Shader\n', 'OpCapability Shader\nOpCapability Linkage\n', 1)
+    t = t.replace('OpName %main "main"\n', 'OpName %main "fx_unused_main"\n', 1)
+    t = re.sub(r'(OpName (%LoadEdramV4_\w+) [^\n]*\n)',
+               r'\1OpDecorate \2 LinkageAttributes "LoadEdramV4" Export\n', t, count=1)
+    return t
+def main_text(copy_name):
+    w = words(f'{sdk}/resolve_fast_32bpp_{copy_name}_cs.h')
+    open(f'{out}/m.spv', 'wb').write(b''.join(struct.pack('<I', x) for x in w))
+    t = run('spirv-dis', f'{out}/m.spv')
+    # Find the EDRAM variable (set 0 binding 0).
+    edram = re.search(r'OpDecorate (%\d+) DescriptorSet 0', t).group(1)
+    ex_struct = re.search(r'(%_struct_\d+) = OpTypeStruct %uint %uint %uint %uint %uint\n', t).group(1)
+    pc_var = re.search(r'(%\d+) = OpVariable %_ptr_PushConstant_' + ex_struct[1:] + ' PushConstant', t).group(1)
+    # Remove the EDRAM block, its decorations and types.
+    sv = re.search(r'%\S+ = OpVariable (%_ptr_Uniform_(%_struct_\d+)|%_ptr_Uniform__struct_\d+) Uniform\n', t)
+    lines = t.split('\n')
+    # struct type of the edram variable
+    vline = [l for l in lines if re.match(r'\s*' + re.escape(edram) + r' = OpVariable', l)][0]
+    ptr_type = vline.split('OpVariable ')[1].split()[0]
+    pline = [l for l in lines if re.match(r'\s*' + re.escape(ptr_type) + r' = OpTypePointer', l)][0]
+    st = pline.split()[-1]
+    sline = [l for l in lines if re.match(r'\s*' + re.escape(st) + r' = OpTypeStruct', l)][0]
+    arr = sline.split()[-1]
+    drop = []
+    for l in lines:
+        s = l.strip()
+        if (re.match(re.escape(edram) + r' ', s) or s.startswith(f'OpDecorate {edram} ') or
+            s.startswith(f'OpMemberDecorate {st} ') or s.startswith(f'OpDecorate {st} ') or
+            s.startswith(f'OpDecorate {arr} ') or re.match(re.escape(ptr_type) + ' =', s) or
+            re.match(re.escape(st) + ' =', s) or re.match(re.escape(arr) + ' =', s)):
+            drop.append(l)
+    for l in drop:
+        lines.remove(l)
+    t = '\n'.join(lines)
+    # Push constant struct: 5 -> 9 dwords.
+    t = t.replace(f'{ex_struct} = OpTypeStruct %uint %uint %uint %uint %uint',
+                  f'{ex_struct} = OpTypeStruct %uint %uint %uint %uint %uint %uint %uint %uint %uint')
+    t = t.replace(f'OpMemberDecorate {ex_struct} 4 Offset 16\n',
+                  f'OpMemberDecorate {ex_struct} 4 Offset 16\n' + ''.join(
+                      f'OpMemberDecorate {ex_struct} {i} Offset {4*i}\n' for i in range(5, 9)))
+    t = t.replace('OpCapability Shader\n', 'OpCapability Shader\nOpCapability Linkage\n', 1)
+    # Calls.
+    pat = re.compile(r'(%\d+) = OpAccessChain %_ptr_Uniform_v4uint ' + re.escape(edram) +
+                     r' %int_0 (%\d+)\n\s*(%\d+) = OpLoad %v4uint \1\n')
+    n = len(pat.findall(t))
+    masks = set()
+    def sub(m):
+        res = m.group(3)
+        mask = 0
+        for c in re.findall(re.escape(res) + r'(?![0-9])', t):
+            pass
+        for mm in re.finditer(r'OpCompositeExtract %uint ' + re.escape(res) + r' (\d)\n', t):
+            mask |= 1 << int(mm.group(1))
+        # Any other use (not an extract) needs all components.
+        uses = len(re.findall(re.escape(res) + r'(?![0-9])', t)) - 1
+        ext = len(re.findall(r'OpCompositeExtract %uint ' + re.escape(res) + r' \d\n', t))
+        if uses != ext or mask == 0:
+            mask = 15
+        masks.add(mask)
+        return (f'OpStore %fx_pidx {m.group(2)}\nOpStore %fx_pex %fx_exv\nOpStore %fx_pmask %fx_mask_{mask}\n'
+                f'{res} = OpFunctionCall %v4uint %fx_load %fx_pidx %fx_pex %fx_pmask\n')
+    t = pat.sub(sub, t)
+    print('call masks', sorted(masks), file=sys.stderr)
+    assert 'OpLoad %v4uint' not in t.split('OpFunction')[1] or True
+    # Types, decls (before first OpFunction).
+    decl = ('%fx_ptr_fn_uint = OpTypePointer Function %uint\n%fx_ptr_fn_v4 = OpTypePointer Function %v4uint\n'
+            '%fx_fn_t = OpTypeFunction %v4uint %fx_ptr_fn_uint %fx_ptr_fn_v4 %fx_ptr_fn_uint\n' + ''.join(f'%fx_mask_{i} = OpConstant %uint {i}\n' for i in range(1, 16)) +
+            '%fx_c5 = OpConstant %int 5\n%fx_c6 = OpConstant %int 6\n%fx_c7 = OpConstant %int 7\n%fx_c8 = OpConstant %int 8\n'
+            '%fx_load = OpFunction %v4uint None %fx_fn_t\n%fx_a0 = OpFunctionParameter %fx_ptr_fn_uint\n'
+            '%fx_a1 = OpFunctionParameter %fx_ptr_fn_v4\n%fx_a2 = OpFunctionParameter %fx_ptr_fn_uint\nOpFunctionEnd\n')
+    i = t.index('OpFunction %void')
+    i = t.rfind('\n', 0, i) + 1
+    t = t[:i] + decl + t[i:]
+    t = t.replace('OpDecorate %gl_WorkGroupSize', 'OpDecorate %fx_load LinkageAttributes "LoadEdramV4" Import\nOpDecorate %gl_WorkGroupSize', 1)
+    # Locals + ex vector in the entry block: the first OpLabel of the main function, after which the
+    # original starts with OpSelectionMerge. Variables must come first; the loads go after them.
+    m = re.search(r'(OpFunction %void None %\d+\n\s*%\d+ = OpLabel\n)', t)
+    ins = ('%fx_pidx = OpVariable %fx_ptr_fn_uint Function\n%fx_pex = OpVariable %fx_ptr_fn_v4 Function\n%fx_pmask = OpVariable %fx_ptr_fn_uint Function\n'
+           f'%fx_pp5 = OpAccessChain %_ptr_PushConstant_uint {pc_var} %fx_c5\n%fx_e5 = OpLoad %uint %fx_pp5\n'
+           f'%fx_pp6 = OpAccessChain %_ptr_PushConstant_uint {pc_var} %fx_c6\n%fx_e6 = OpLoad %uint %fx_pp6\n'
+           f'%fx_pp7 = OpAccessChain %_ptr_PushConstant_uint {pc_var} %fx_c7\n%fx_e7 = OpLoad %uint %fx_pp7\n'
+           f'%fx_pp8 = OpAccessChain %_ptr_PushConstant_uint {pc_var} %fx_c8\n%fx_e8 = OpLoad %uint %fx_pp8\n'
+           '%fx_exv = OpCompositeConstruct %v4uint %fx_e5 %fx_e6 %fx_e7 %fx_e8\n')
+    t = t[:m.end()] + ins + t[m.end():]
+    return t, n
+def build(copy_name, depth, msaa, ms):
+    mt, n = main_text(copy_name)
+    open(f'{out}/m.spvasm', 'w').write(mt)
