+// ======================= Fused direct resolve (roadmap 1l) =======================
+// In the host render target path the EDRAM buffer is only scratch between DumpRenderTargets and
+// the resolve copy that follows it. For the fast 32bpp copies (shaders 0 and 1) the dump is skipped:
+// the copy shader is a patched variant (tools: src/graphics/shaders/fused_resolve/gen.py) whose EDRAM
+// loads are LoadEdramV4 calls reading the render target image and packing like the dump shader.
+
+namespace {
+const uint32_t* GetFusedShaderCode(bool is_depth, uint32_t msaa_log2, bool host_ms, size_t& size) {
+#define NHL_FUSED_CASE(d, m, h)                                              \
+  size = sizeof(shaders::resolve_fused_fast_32bpp_d##d##_m##m##_h##h##_cs); \
+  return shaders::resolve_fused_fast_32bpp_d##d##_m##m##_h##h##_cs
+  if (is_depth) {
+    if (msaa_log2 == 0) { NHL_FUSED_CASE(1, 1, 0); }
+    if (msaa_log2 == 1) { if (host_ms) { NHL_FUSED_CASE(1, 2, 1); } NHL_FUSED_CASE(1, 2, 0); }
+    if (host_ms) { NHL_FUSED_CASE(1, 4, 1); } NHL_FUSED_CASE(1, 4, 0);
+  }
+  if (msaa_log2 == 0) { NHL_FUSED_CASE(0, 1, 0); }
+  if (msaa_log2 == 1) { if (host_ms) { NHL_FUSED_CASE(0, 2, 1); } NHL_FUSED_CASE(0, 2, 0); }
+  if (host_ms) { NHL_FUSED_CASE(0, 4, 1); } NHL_FUSED_CASE(0, 4, 0);
+#undef NHL_FUSED_CASE
+}
+}  // namespace
+
+bool VulkanRenderTargetCache::FusedVerifyWanted() {
+  static const bool env = std::getenv("REX_NHL_DIRECT_VERIFY") != nullptr &&
+                          std::getenv("REX_NHL_DIRECT_VERIFY")[0] != '0';
+  if (!env && !REXCVAR_GET(nhl_direct_resolve_verify)) {
+    return false;
+  }
+  return fused_verify_issued_ + fused_verify_skipped_ < uint32_t(std::max(1, std::min<int32_t>(
+                                                            REXCVAR_GET(nhl_direct_resolve_verify_count),
+                                                            int32_t(kFusedVerifySlots))));
+}
+
+VkPipeline VulkanRenderTargetCache::GetFusedPipeline(bool is_depth, uint32_t msaa_log2,
+                                                     bool host_multisampled) {
+  const uint32_t h = (msaa_log2 && host_multisampled) ? 1 : 0;
+  VkPipeline& pipeline = fused_pipelines_[is_depth][msaa_log2][h];
+  if (fused_pipeline_tried_[is_depth][msaa_log2][h]) {
+    return pipeline;
+  }
+  fused_pipeline_tried_[is_depth][msaa_log2][h] = true;
+  VkPipelineLayout layout =
+      is_depth ? direct_resolve_pipeline_layout_depth_ : direct_resolve_pipeline_layout_color_;
+  if (layout == VK_NULL_HANDLE) {
+    return VK_NULL_HANDLE;
+  }
+  size_t size_bytes;
+  const uint32_t* code = GetFusedShaderCode(is_depth, msaa_log2, h != 0, size_bytes);
+  pipeline = ui::vulkan::util::CreateComputePipeline(command_processor_.GetVulkanDevice(), layout,
+                                                     code, size_bytes);
+  if (pipeline == VK_NULL_HANDLE) {
+    REXGPU_ERROR("[nhl-direct] failed to create the fused resolve pipeline depth={} msaa_log2={} "
+                 "host_ms={}", is_depth, msaa_log2, h);
+  }
+  return pipeline;
+}
+
+void VulkanRenderTargetCache::PrepareFusedResolve(const draw_util::ResolveInfo& resolve_info,
+                                                  draw_util::ResolveCopyShaderIndex copy_shader,
+                                                  bool draw_resolution_scaled) {
+  ++fused_resolves_;
+  FusedVerifyPoll();
+  fused_.valid = false;
+  fused_.reason = 0;
+  fused_.pipeline = VK_NULL_HANDLE;
+  fused_.render_target = nullptr;
+  fused_.span_tiles.clear();
+  fused_.covered_tiles.clear();
+  uint32_t base, row_len, rows, pitch;
+  resolve_info.GetCopyEdramTileSpan(base, row_len, rows, pitch);
+  for (uint32_t r = 0; r < rows; ++r) {
+    for (uint32_t c = 0; c < row_len; ++c) {
+      fused_.span_tiles.push_back(uint16_t((base + r * pitch + c) & (xenos::kEdramTileCount - 1)));
+    }
+  }
+  GetResolveCopyRectanglesToDump(base, row_len, rows, pitch, dump_rectangles_);
+  for (const ResolveCopyDumpRectangle& rc : dump_rectangles_) {
+    for (uint32_t r = rc.row_first; r < rc.row_first + rc.rows; ++r) {
+      uint32_t c0 = (r == rc.row_first) ? rc.row_first_start : 0;
+      uint32_t c1 = (r == rc.row_first + rc.rows - 1) ? rc.row_last_end : row_len;
+      for (uint32_t c = c0; c < c1; ++c) {
+        fused_.covered_tiles.push_back(
+            uint16_t((base + r * pitch + c) & (xenos::kEdramTileCount - 1)));
+      }
+    }
+  }
+  const bool depth = resolve_info.IsCopyingDepth();
+  const xenos::MsaaSamples msaa =
+      depth ? resolve_info.depth_edram_info.msaa_samples : resolve_info.color_edram_info.msaa_samples;
+  fused_.class_key = uint32_t(copy_shader) | (uint32_t(depth) << 4) | (uint32_t(msaa) << 5) |
+                     (std::min(rows, 255u) << 8) | (std::min(row_len, 255u) << 16);
+  // Reasons: 1 shader is not fast 32bpp, 2 scaled, 3 no owner, 4 several owners, 5 partial cover,
+  // 6 64bpp / sample count mismatch, 7 unsupported format, 8 pipeline unavailable, 9 not host RT.
+  uint32_t reason = 0;
+  VulkanRenderTarget* rt = nullptr;
+  if (copy_shader != draw_util::ResolveCopyShaderIndex::kFast32bpp1x2xMSAA &&
+      copy_shader != draw_util::ResolveCopyShaderIndex::kFast32bpp4xMSAA) {
+    reason = 1;
+  } else if (draw_resolution_scaled) {
+    reason = 2;
+  } else if (dump_rectangles_.empty()) {
+    reason = 3;
+  } else if (dump_rectangles_.size() > 1) {
+    reason = 4;
+  } else {
+    const ResolveCopyDumpRectangle& rc = dump_rectangles_[0];
+    if (rc.row_first != 0 || rc.rows != rows || rc.row_first_start != 0 ||
+        rc.row_last_end != row_len || fused_.covered_tiles.size() != fused_.span_tiles.size()) {
+      reason = 5;
+    } else {
+      rt = static_cast<VulkanRenderTarget*>(rc.render_target);
+      const RenderTargetKey k = rt->key();
+      const bool want_4x = copy_shader == draw_util::ResolveCopyShaderIndex::kFast32bpp4xMSAA;
+      if (k.Is64bpp() || (k.msaa_samples == xenos::MsaaSamples::k4X) != want_4x ||
+          k.is_depth != depth) {
+        reason = 6;
+      } else {
+        uint32_t flags = 0;
+        const bool ms2x = k.msaa_samples == xenos::MsaaSamples::k2X;
+        flags |= draw_util::GetD3D10SampleIndexForGuest2xMSAA(0, msaa_2x_attachments_supported_);
+        flags |= draw_util::GetD3D10SampleIndexForGuest2xMSAA(1, msaa_2x_attachments_supported_) << 4;
+        (void)ms2x;
+        if (depth_float24_round_) flags |= 256;
+        if (gamma_render_target_as_unorm16_) flags |= 512;
+        if (k.is_depth) {
+          if (k.GetDepthFormat() == xenos::DepthRenderTargetFormat::kD24FS8) flags |= 1024;
+        } else {
+          bool is_uint = false;
+          GetColorOwnershipTransferVulkanFormat(k.GetColorFormat(), k.msaa_samples, &is_uint);
+          uint32_t fmt = 15;
+          switch (k.GetColorFormat()) {
+            case xenos::ColorRenderTargetFormat::k_8_8_8_8: fmt = 0; break;
+            case xenos::ColorRenderTargetFormat::k_8_8_8_8_GAMMA: fmt = 1; break;
+            case xenos::ColorRenderTargetFormat::k_2_10_10_10:
+            case xenos::ColorRenderTargetFormat::k_2_10_10_10_AS_10_10_10_10: fmt = 2; break;
+            default: break;
+          }
+          if (is_uint || fmt == 15) {
+            reason = 7;
+          }
+          flags |= fmt << 12;
+        }
+        if (!reason) {
+          const uint32_t msaa_log2 = uint32_t(k.msaa_samples);
+          const bool host_ms = k.msaa_samples != xenos::MsaaSamples::k1X && !host_msaa_1x_;
+          VkPipeline pipeline = GetFusedPipeline(k.is_depth, msaa_log2, host_ms);
+          if (pipeline == VK_NULL_HANDLE) {
+            reason = 8;
+          } else {
+            fused_.pipeline = pipeline;
+            fused_.layout = k.is_depth ? direct_resolve_pipeline_layout_depth_
+                                       : direct_resolve_pipeline_layout_color_;
+            fused_.render_target = rt;
+            fused_.extra[0] = k.base_tiles + (std::getenv("REX_NHL_DIRECT_VERIFY_NEG") ? 1 : 0);
+            fused_.extra[1] = std::max(1u, k.GetPitchTiles());
+            fused_.extra[2] = flags;
+            fused_.extra[3] = 0;
+          }
+        }
+      }
+    }
+  }
+  fused_.reason = reason;
+  fused_.valid = reason == 0;
+  FusedStats& st = fused_stats_[fused_.class_key];
+  ++st.count;
+  st.span_tiles += fused_.span_tiles.size();
+  st.covered_tiles += fused_.covered_tiles.size();
+  ++st.reasons[std::min(reason, 11u)];
+  if (fused_.valid) {
+    ++st.eligible;
+  }
+}
+
+void VulkanRenderTargetCache::FusedTrackTiles(bool dump_skipped) {
+  if (dump_skipped) {
+    for (uint16_t t : fused_.covered_tiles) {
+      edram_skipped_.set(t);
+    }
+    return;
+  }
+  std::bitset<xenos::kEdramTileCount> covered;
+  for (uint16_t t : fused_.covered_tiles) {
+    covered.set(t);
+  }
+  uint32_t stale = 0;
+  for (uint16_t t : fused_.span_tiles) {
+    if (!covered[t] && edram_skipped_[t]) {
+      ++stale;
+    }
+  }
+  if (stale) {
+    ++fused_stale_resolves_;
+    fused_stale_reads_ += stale;
+    if (fused_stale_resolves_ <= 20) {
+      REXGPU_WARN("[nhl-direct] STALE READ risk: resolve class {:08X} reads {} EDRAM tiles that "
+                  "were only dumped by skipped dumps", fused_.class_key, stale);
+    }
+  }
+  for (uint16_t t : fused_.covered_tiles) {
+    edram_skipped_.reset(t);
+  }
+}
+
+void VulkanRenderTargetCache::FusedMaybeLogStats() {
+  static const bool verify_env = std::getenv("REX_NHL_DIRECT_VERIFY") != nullptr;
+  if (!fused_stats_env_ && !verify_env && !REXCVAR_GET(nhl_direct_resolve_verify)) {
+    return;
+  }
+  auto now = std::chrono::steady_clock::now();
+  if (fused_last_log_.time_since_epoch().count() == 0) {
+    fused_last_log_ = now;
+    return;
+  }
+  if (std::chrono::duration_cast<std::chrono::seconds>(now - fused_last_log_).count() < 10) {
+    return;
+  }
+  fused_last_log_ = now;
+  for (const auto& e : fused_stats_) {
+    const uint32_t k = e.first;
+    const FusedStats& st = e.second;
+    REXGPU_INFO("[nhl-direct] class shader={} depth={} msaa={} rows={} row_len={} n={} eligible={} "
+                "span_tiles={} covered_tiles={} reasons(shader,scaled,noowner,multi,partial,"
+                "64bpp,fmt,pipe)={},{},{},{},{},{},{},{}",
+                k & 15, (k >> 4) & 1, (k >> 5) & 7, (k >> 8) & 255, (k >> 16) & 255, st.count,
+                st.eligible, st.span_tiles, st.covered_tiles, st.reasons[1], st.reasons[2],
+                st.reasons[3], st.reasons[4], st.reasons[5], st.reasons[6], st.reasons[7],
+                st.reasons[8]);
+  }
+  REXGPU_INFO("[nhl-direct] total resolves={} skipped_dumps={} stale_resolves={} stale_tiles={}",
+              fused_resolves_, fused_skipped_, fused_stale_resolves_, fused_stale_reads_);
+}
+
+void VulkanRenderTargetCache::FusedTransitionSource() {
+  VulkanRenderTarget& vulkan_rt = *fused_.render_target;
+  RenderTargetKey rt_key = vulkan_rt.key();
+  command_processor_.PushImageMemoryBarrier(
+      vulkan_rt.image(),
+      ui::vulkan::util::InitializeSubresourceRange(
+          rt_key.is_depth ? (VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT)
+                          : VK_IMAGE_ASPECT_COLOR_BIT),
+      vulkan_rt.current_stage_mask(), VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+      vulkan_rt.current_access_mask(), VK_ACCESS_SHADER_READ_BIT, vulkan_rt.current_layout(),
+      VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  vulkan_rt.SetUsage(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT,
+                     VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+}
+
+void VulkanRenderTargetCache::FusedPoisonEdram() {
+  // REX_NHL_DUMP_POISON with the fused resolve: any later reader of the EDRAM buffer shows magenta.
+  UseEdramBuffer(EdramBufferUsage::kTransferWrite);
+  command_processor_.SubmitBarriers(true);
+  command_processor_.deferred_command_buffer().CmdVkFillBuffer(
+      edram_buffer_, 0,
+      VkDeviceSize(xenos::kEdramSizeBytes) *
+          (draw_resolution_scale_x() * draw_resolution_scale_y()),
+      0xFF00FFFFu);
+  MarkEdramBufferModified();
+}
+
+bool VulkanRenderTargetCache::FusedCreateVerifyResources() {
+  if (fused_verify_resources_tried_) {
+    return fused_compare_pipeline_ != VK_NULL_HANDLE;
+  }
+  fused_verify_resources_tried_ = true;
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  fused_scratch_size_ = 12 * 1024 * 1024;
+  if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+          vulkan_device, fused_scratch_size_,
+          VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT |
+              VK_BUFFER_USAGE_STORAGE_BUFFER_BIT,
+          ui::vulkan::util::MemoryPurpose::kDeviceLocal, fused_scratch_buffer_,
+          fused_scratch_memory_)) {
+    REXGPU_ERROR("[nhl-direct-verify] failed to create the scratch buffer");
+    return false;
+  }
+  const VkDeviceSize results_size = VkDeviceSize(kFusedVerifySlots) * 8 * sizeof(uint32_t);
+  if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+          vulkan_device, results_size,
+          VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+          ui::vulkan::util::MemoryPurpose::kReadback, fused_result_buffer_, fused_result_memory_)) {
+    REXGPU_ERROR("[nhl-direct-verify] failed to create the results buffer");
+    return false;
+  }
+  void* mapped = nullptr;
+  if (dfn.vkMapMemory(device, fused_result_memory_, 0, VK_WHOLE_SIZE, 0, &mapped) != VK_SUCCESS ||
+      !mapped) {
+    REXGPU_ERROR("[nhl-direct-verify] failed to map the results buffer");
+    return false;
+  }
+  fused_results_ = static_cast<uint32_t*>(mapped);
+  std::memset(fused_results_, 0, size_t(results_size));
+  VkMappedMemoryRange range = {};
+  range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+  range.memory = fused_result_memory_;
+  range.offset = 0;
+  range.size = VK_WHOLE_SIZE;
+  dfn.vkFlushMappedMemoryRanges(device, 1, &range);
+  VkDescriptorSetLayout layouts[2] = {
+      command_processor_.GetSingleTransientDescriptorLayout(
+          VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferPairCompute),
+      command_processor_.GetSingleTransientDescriptorLayout(
+          VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute)};
+  VkPushConstantRange pc;
+  pc.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+  pc.offset = 0;
+  pc.size = 2 * sizeof(uint32_t);
+  VkPipelineLayoutCreateInfo info = {};
+  info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+  info.setLayoutCount = 2;
+  info.pSetLayouts = layouts;
+  info.pushConstantRangeCount = 1;
+  info.pPushConstantRanges = &pc;
+  if (dfn.vkCreatePipelineLayout(device, &info, nullptr, &fused_compare_layout_) != VK_SUCCESS) {
+    return false;
+  }
+  fused_compare_pipeline_ = ui::vulkan::util::CreateComputePipeline(
+      vulkan_device, fused_compare_layout_, shaders::resolve_fused_compare_cs,
+      sizeof(shaders::resolve_fused_compare_cs));
+  return fused_compare_pipeline_ != VK_NULL_HANDLE;
+}
+
+void VulkanRenderTargetCache::FusedDestroy() {
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  for (auto& a : fused_pipelines_) {
+    for (auto& b : a) {
+      for (VkPipeline& p : b) {
+        if (p != VK_NULL_HANDLE) {
+          dfn.vkDestroyPipeline(device, p, nullptr);
+          p = VK_NULL_HANDLE;
+        }
+      }
+    }
+  }
+  std::memset(fused_pipeline_tried_, 0, sizeof(fused_pipeline_tried_));
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyPipeline, device, fused_compare_pipeline_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyPipelineLayout, device, fused_compare_layout_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyBuffer, device, fused_scratch_buffer_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkFreeMemory, device, fused_scratch_memory_);
+  if (fused_results_) {
+    dfn.vkUnmapMemory(device, fused_result_memory_);
+    fused_results_ = nullptr;
+  }
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyBuffer, device, fused_result_buffer_);
+  ui::vulkan::util::DestroyAndNullHandle(dfn.vkFreeMemory, device, fused_result_memory_);
+  fused_verify_resources_tried_ = false;
+}
+
+uint32_t VulkanRenderTargetCache::FusedVerifyBegin(
+    VulkanSharedMemory& shared_memory, const draw_util::ResolveInfo& resolve_info,
+    draw_util::ResolveCopyShaderIndex copy_shader, VkDeviceSize dest_range_offset,
+    VkDeviceSize dest_range_length, const draw_util::ResolveCopyShaderConstants& constants,
+    uint32_t group_count_x, uint32_t group_count_y) {
+  const uint32_t limit = uint32_t(std::max(
+      1, std::min<int32_t>(REXCVAR_GET(nhl_direct_resolve_verify_count), int32_t(kFusedVerifySlots))));
+  if (fused_verify_issued_ >= limit) {
+    return UINT32_MAX;
+  }
+  uint32_t& class_count = fused_verify_per_class_[fused_.class_key];
+  if (class_count >= std::max(10u, limit / 5)) {
+    return UINT32_MAX;
+  }
+  if (!FusedCreateVerifyResources()) {
+    return UINT32_MAX;
+  }
+  if (dest_range_length > fused_scratch_size_ || (dest_range_length & 3)) {
+    ++fused_verify_skipped_;
+    REXGPU_WARN("[nhl-direct-verify] resolve skipped, destination range {} too big for the scratch",
+                dest_range_length);
+    return UINT32_MAX;
+  }
+  ++class_count;
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  auto buffer_barrier = [&](VkBuffer buffer, VkDeviceSize size, VkPipelineStageFlags src_stage,
+                            VkAccessFlags src_access, VkPipelineStageFlags dst_stage,
+                            VkAccessFlags dst_access) {
+    VkBufferMemoryBarrier b = {};
+    b.sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER;
+    b.srcAccessMask = src_access;
+    b.dstAccessMask = dst_access;
+    b.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    b.buffer = buffer;
+    b.offset = 0;
+    b.size = size;
+    command_buffer.CmdVkPipelineBarrier(src_stage, dst_stage, 0, 0, nullptr, 1, &b, 0, nullptr);
+  };
+  // Seed the scratch buffer with the destination before the real copy.
+  shared_memory.Use(VulkanSharedMemory::Usage::kRead);
+  command_processor_.SubmitBarriers(true);
+  buffer_barrier(fused_scratch_buffer_, VK_WHOLE_SIZE,
+                 VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT,
+                 VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT,
+                 VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT);
+  VkBufferCopy copy_region;
+  copy_region.srcOffset = dest_range_offset;
+  copy_region.dstOffset = 0;
+  copy_region.size = dest_range_length;
+  command_buffer.CmdVkCopyBuffer(shared_memory.buffer(), fused_scratch_buffer_, 1, &copy_region);
+  buffer_barrier(fused_scratch_buffer_, VK_WHOLE_SIZE, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                 VK_ACCESS_TRANSFER_WRITE_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                 VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT);
+  // The fused copy into the scratch buffer.
+  VkDescriptorSet scratch_set = command_processor_.AllocateSingleTransientDescriptor(
+      VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute);
+  if (scratch_set == VK_NULL_HANDLE) {
+    ++fused_verify_skipped_;
+    return UINT32_MAX;
+  }
+  VkDescriptorBufferInfo bi;
+  bi.buffer = fused_scratch_buffer_;
+  bi.offset = 0;
+  bi.range = dest_range_length;
+  VkWriteDescriptorSet w = {};
+  w.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+  w.dstSet = scratch_set;
+  w.descriptorCount = 1;
+  w.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+  w.pBufferInfo = &bi;
+  dfn.vkUpdateDescriptorSets(device, 1, &w, 0, nullptr);
+  FusedTransitionSource();
+  command_processor_.BindExternalComputePipeline(fused_.pipeline);
+  VkDescriptorSet sets[2] = {fused_.render_target->GetDescriptorSetTransferSource(), scratch_set};
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE, fused_.layout, 0, 2, sets,
+                                         0, nullptr);
+  DirectResolvePushConstants push;
+  push.resolve = constants;
+  push.resolve.dest_base -= uint32_t(dest_range_offset);
+  std::memcpy(push.extra, fused_.extra, sizeof(push.extra));
+  command_buffer.CmdVkPushConstants(fused_.layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(push),
+                                    &push);
+  command_processor_.SubmitBarriers(true);
+  command_buffer.CmdVkDispatch(group_count_x, group_count_y, 1);
+
+  const uint32_t slot = fused_verify_issued_++;
+  const RenderTargetKey k = fused_.render_target->key();
+  fused_verify_issue_resolve_.push_back(command_processor_.GetCurrentSubmission());
+  fused_verify_desc_.push_back(fmt::format(
+      "resolve#{} shader={} depth={} msaa={} rt_fmt={} rt_base={} rt_pitch={} rows={} row_len={} "
+      "dest={:08X} extent={:08X}+{:X} range_off={:X} len={:X} endian={} flags={:X}",
+      fused_resolves_, uint32_t(copy_shader), uint32_t(k.is_depth), uint32_t(k.msaa_samples),
+      uint32_t(k.resource_format), uint32_t(k.base_tiles), k.GetPitchTiles(),
+      (fused_.class_key >> 8) & 255, (fused_.class_key >> 16) & 255, resolve_info.copy_dest_base,
+      resolve_info.copy_dest_extent_start, resolve_info.copy_dest_extent_length,
+      uint64_t(dest_range_offset), uint64_t(dest_range_length),
+      uint32_t(resolve_info.copy_dest_info.copy_dest_endian), fused_.extra[2]));
+  return slot;
+}
+
+void VulkanRenderTargetCache::FusedVerifyEnd(VulkanSharedMemory& shared_memory, uint32_t slot,
+                                             VkDeviceSize dest_range_offset,
+                                             VkDeviceSize dest_range_length,
+                                             VkDescriptorSet dest_set) {
+  (void)dest_set;
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  // The real copy has just been dispatched: shared memory compute write -> compute read.
+  shared_memory.Use(VulkanSharedMemory::Usage::kRead);
+  command_processor_.SubmitBarriers(true);
+  VkBufferMemoryBarrier b = {};
+  b.sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER;
+  b.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+  b.dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+  b.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+  b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+  b.buffer = fused_scratch_buffer_;
+  b.offset = 0;
+  b.size = VK_WHOLE_SIZE;
+  command_buffer.CmdVkPipelineBarrier(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                                      VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 0, nullptr, 1, &b, 0,
+                                      nullptr);
+  VkDescriptorSet pair_set = command_processor_.AllocateSingleTransientDescriptor(
+      VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferPairCompute);
+  VkDescriptorSet results_set = command_processor_.AllocateSingleTransientDescriptor(
+      VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute);
+  if (pair_set == VK_NULL_HANDLE || results_set == VK_NULL_HANDLE) {
+    return;
+  }
+  VkDescriptorBufferInfo infos[3] = {};
+  infos[0].buffer = shared_memory.buffer();
+  infos[0].offset = dest_range_offset;
+  infos[0].range = dest_range_length;
+  infos[1].buffer = fused_scratch_buffer_;
+  infos[1].offset = 0;
+  infos[1].range = dest_range_length;
+  infos[2].buffer = fused_result_buffer_;
+  infos[2].offset = 0;
+  infos[2].range = VK_WHOLE_SIZE;
+  VkWriteDescriptorSet writes[3] = {};
+  for (uint32_t i = 0; i < 3; ++i) {
+    writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    writes[i].dstSet = i < 2 ? pair_set : results_set;
+    writes[i].dstBinding = i < 2 ? i : 0;
+    writes[i].descriptorCount = 1;
+    writes[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+    writes[i].pBufferInfo = &infos[i];
+  }
+  dfn.vkUpdateDescriptorSets(device, 3, writes, 0, nullptr);
+  command_processor_.BindExternalComputePipeline(fused_compare_pipeline_);
+  VkDescriptorSet sets[2] = {pair_set, results_set};
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE, fused_compare_layout_, 0,
+                                         2, sets, 0, nullptr);
+  uint32_t pc[2] = {uint32_t(dest_range_length / 4), slot};
+  command_buffer.CmdVkPushConstants(fused_compare_layout_, VK_SHADER_STAGE_COMPUTE_BIT, 0,
+                                    sizeof(pc), pc);
+  command_processor_.SubmitBarriers(true);
+  command_buffer.CmdVkDispatch((pc[0] + 63) / 64, 1, 1);
+  VkBufferMemoryBarrier hb = {};
+  hb.sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER;
+  hb.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+  hb.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+  hb.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+  hb.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+  hb.buffer = fused_result_buffer_;
+  hb.offset = 0;
+  hb.size = VK_WHOLE_SIZE;
+  command_buffer.CmdVkPipelineBarrier(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                                      VK_PIPELINE_STAGE_HOST_BIT, 0, 0, nullptr, 1, &hb, 0,
+                                      nullptr);
+}
+
+void VulkanRenderTargetCache::FusedVerifyPoll() {
+  if (!fused_results_ || fused_verify_polled_ >= fused_verify_issued_) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  const uint64_t completed = command_processor_.GetCompletedSubmission();
+  if (fused_verify_issue_resolve_[fused_verify_polled_] > completed) {
+    return;
+  }
+  VkMappedMemoryRange range = {};
+  range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+  range.memory = fused_result_memory_;
+  range.offset = 0;
+  range.size = VK_WHOLE_SIZE;
+  dfn.vkInvalidateMappedMemoryRanges(device, 1, &range);
+  bool progressed = false;
+  while (fused_verify_polled_ < fused_verify_issued_ &&
+         fused_verify_issue_resolve_[fused_verify_polled_] <= completed) {
+    const uint32_t s = fused_verify_polled_++;
+    progressed = true;
+    const uint32_t* r = fused_results_ + size_t(s) * 8;
+    if (r[1] != 0xC0DE0001u) {
+      REXGPU_WARN("[nhl-direct-verify] slot {} not written by the GPU: {}", s,
+                  fused_verify_desc_[s]);
+      continue;
+    }
+    if (r[0]) {
+      ++fused_verify_mismatch_resolves_;
+      fused_verify_mismatch_dwords_ += r[0];
+      if (fused_verify_mismatch_resolves_ <= 40) {
+        REXGPU_WARN("[nhl-direct-verify] MISMATCH {} dwords: {} first dword {} real={:08X} "
+                    "fused={:08X}", r[0], fused_verify_desc_[s], r[2], r[3], r[4]);
+      }
+    }
+  }
+  const bool nhl_done = fused_verify_polled_ >= uint32_t(std::min<int32_t>(
+      REXCVAR_GET(nhl_direct_resolve_verify_count), int32_t(kFusedVerifySlots)));
+  if (progressed && (nhl_done || fused_verify_polled_ / 20 != fused_verify_last_report_ / 20)) {
+    fused_verify_last_report_ = fused_verify_polled_;
+    if (nhl_done || fused_verify_polled_ >= 400) {
+      for (const auto& pc : fused_verify_per_class_) {
+        REXGPU_INFO("[nhl-direct-verify] class shader={} depth={} msaa={} rows={} row_len={} verified={}",
+                    pc.first & 15, (pc.first >> 4) & 1, (pc.first >> 5) & 7, (pc.first >> 8) & 255,
+                    (pc.first >> 16) & 255, pc.second);
+      }
+    }
+    REXGPU_INFO("[nhl-direct-verify] compared={} mismatching_resolves={} mismatching_dwords={} "
+                "skipped={}{}", fused_verify_polled_, fused_verify_mismatch_resolves_,
+                fused_verify_mismatch_dwords_, fused_verify_skipped_,
+                fused_verify_polled_ >= uint32_t(std::min<int32_t>(
+                    REXCVAR_GET(nhl_direct_resolve_verify_count), int32_t(kFusedVerifySlots)))
+                    ? " DONE" : "");
+  }
+}
