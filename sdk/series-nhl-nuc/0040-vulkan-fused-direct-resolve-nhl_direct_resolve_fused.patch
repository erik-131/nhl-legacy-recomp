+  uint64_t fused_resolves_ = 0, fused_skipped_ = 0, fused_stale_reads_ = 0, fused_stale_resolves_ = 0;
+  std::chrono::steady_clock::time_point fused_last_log_;
+  bool fused_stats_env_ = false, fused_poison_env_ = false, fused_env_read_ = false;
+  // Verify.
+  static constexpr uint32_t kFusedVerifySlots = 512;
+  VkBuffer fused_scratch_buffer_ = VK_NULL_HANDLE;
