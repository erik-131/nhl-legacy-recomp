 }
 
 void VulkanSharedMemory::Shutdown(bool from_destructor) {
+  upload_prepass_.reset();
   upload_buffer_pool_.reset();
 
   const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
@@ -273,6 +283,36 @@ bool VulkanSharedMemory::UploadRanges(
   if (upload_page_ranges.empty()) {
     return true;
   }
+  bool successful = true;
+  if (upload_prepass_ && REXCVAR_GET(nhl_upload_prepass)) {
+    bool prepass = true;
+    for (const std::pair<uint32_t, uint32_t>& range : upload_page_ranges) {
+      if (PagesRequestedInSubmission(range.first, range.second)) {
+        prepass = false;
+        break;
+      }
+    }
+    if (prepass) {
+      // Nothing earlier in this submission reads or writes these pages, so the copy can happen
+      // before all of it - the barriers around the pre-pass are recorded in ExecuteUploadPrepass.
+      RecordUploadCopies(*upload_prepass_, upload_page_ranges, successful);
+      upload_prepass_empty_ = false;
+      ++prepass_stat_uploads_;
+    } else {
+      ++prepass_stat_inline_;
+    }
+    static auto stat_t0 = std::chrono::steady_clock::now();
+    const auto now = std::chrono::steady_clock::now();
+    if (now - stat_t0 >= std::chrono::seconds(1)) {
+      REXGPU_INFO("[nhl-prepass] uploads prepass={} inline={} prepass_pages={}",
+                  prepass_stat_uploads_, prepass_stat_inline_, prepass_stat_pages_);
+      prepass_stat_uploads_ = prepass_stat_inline_ = prepass_stat_pages_ = 0;
+      stat_t0 = now;
+    }
+    if (prepass) {
+      return successful;
+    }
+  }
   // upload_page_ranges are sorted, use them to determine the range for the
   // ordering barrier.
   Use(Usage::kTransferDestination,
@@ -281,9 +321,14 @@ bool VulkanSharedMemory::UploadRanges(
                       upload_page_ranges.front().first)
                          << page_size_log2()));
   command_processor_.SubmitBarriers(true);
-  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  RecordUploadCopies(command_processor_.deferred_command_buffer(), upload_page_ranges, successful);
+  return successful;
+}
+
+void VulkanSharedMemory::RecordUploadCopies(
+    DeferredCommandBuffer& command_buffer,
+    const std::vector<std::pair<uint32_t, uint32_t>>& upload_page_ranges, bool& successful) {
   uint64_t submission_current = command_processor_.GetCurrentSubmission();
-  bool successful = true;
   upload_regions_.clear();
   VkBuffer upload_buffer_previous = VK_NULL_HANDLE;
   for (auto upload_range : upload_page_ranges) {
@@ -317,6 +362,9 @@ bool VulkanSharedMemory::UploadRanges(
       uint32_t upload_buffer_pages = uint32_t(upload_buffer_size >> page_size_log2());
       upload_range_start += upload_buffer_pages;
       upload_range_length -= upload_buffer_pages;
+      if (&command_buffer == upload_prepass_.get()) {
+        prepass_stat_pages_ += upload_buffer_pages;
+      }
     }
     if (!successful) {
       break;
@@ -328,7 +376,93 @@ bool VulkanSharedMemory::UploadRanges(
                                    uint32_t(upload_regions_.size()), upload_regions_.data());
     upload_regions_.clear();
   }
-  return successful;
+}
+
+bool VulkanSharedMemory::PagesRequestedInSubmission(uint32_t page_first,
+                                                    uint32_t page_count) const {
+  if (!page_count) {
+    return false;
+  }
+  uint32_t page_last = page_first + page_count - 1;
+  for (uint32_t block = page_first >> 6; block <= (page_last >> 6); ++block) {
+    uint64_t mask = ~uint64_t(0);
+    if (block == (page_first >> 6)) {
+      mask &= ~uint64_t(0) << (page_first & 63);
+    }
+    if (block == (page_last >> 6) && (page_last & 63) != 63) {
+      mask &= (uint64_t(1) << ((page_last & 63) + 1)) - 1;
+    }
+    if (submission_requested_pages_[block] & mask) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void VulkanSharedMemory::RangesRequested(
+    const std::vector<std::pair<uint32_t, uint32_t>>& byte_ranges) {
+  if (submission_requested_pages_.empty()) {
+    return;
+  }
+  for (const std::pair<uint32_t, uint32_t>& range : byte_ranges) {
+    if (!range.second) {
+      continue;
+    }
+    uint32_t page_first = range.first >> page_size_log2();
+    uint32_t page_last = (range.first + (range.second - 1)) >> page_size_log2();
+    for (uint32_t block = page_first >> 6; block <= (page_last >> 6); ++block) {
+      uint64_t mask = ~uint64_t(0);
+      if (block == (page_first >> 6)) {
+        mask &= ~uint64_t(0) << (page_first & 63);
+      }
+      if (block == (page_last >> 6) && (page_last & 63) != 63) {
+        mask &= (uint64_t(1) << ((page_last & 63) + 1)) - 1;
+      }
+      submission_requested_pages_[block] |= mask;
+    }
+  }
+}
+
+void VulkanSharedMemory::BeginSubmissionUploadPrepass() {
+  if (upload_prepass_) {
+    upload_prepass_->Reset();
+  }
+  upload_prepass_empty_ = true;
+  std::fill(submission_requested_pages_.begin(), submission_requested_pages_.end(), 0);
+}
+
+void VulkanSharedMemory::ExecuteUploadPrepass(VkCommandBuffer command_buffer) {
+  if (upload_prepass_empty_) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice::Functions& dfn = command_processor_.GetVulkanDevice()->functions();
+  // Everything that may have accessed the buffer in earlier submissions vs. the pre-pass copies,
+  // then the copies vs. every way the main stream may access the buffer.
+  VkPipelineStageFlags access_stages = VK_PIPELINE_STAGE_VERTEX_INPUT_BIT |
+                                       guest_shader_pipeline_stages_ |
+                                       VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT |
+                                       VK_PIPELINE_STAGE_TRANSFER_BIT;
+  VkBufferMemoryBarrier barrier;
+  barrier.sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER;
+  barrier.pNext = nullptr;
+  barrier.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT;
+  barrier.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+  barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+  barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+  barrier.buffer = buffer_;
+  barrier.offset = 0;
+  barrier.size = VK_WHOLE_SIZE;
+  dfn.vkCmdPipelineBarrier(command_buffer, access_stages, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0,
+                           nullptr, 1, &barrier, 0, nullptr);
+  upload_prepass_->Execute(command_buffer);
+  barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+  barrier.dstAccessMask = VK_ACCESS_INDEX_READ_BIT | VK_ACCESS_SHADER_READ_BIT |
+                          VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_READ_BIT |
+                          VK_ACCESS_TRANSFER_WRITE_BIT;
+  dfn.vkCmdPipelineBarrier(command_buffer, VK_PIPELINE_STAGE_TRANSFER_BIT, access_stages, 0, 0,
+                           nullptr, 1, &barrier, 0, nullptr);
+  upload_prepass_->Reset();
+  upload_prepass_empty_ = true;
 }
 
 void VulkanSharedMemory::GetUsageMasks(Usage usage, VkPipelineStageFlags& stage_mask,
