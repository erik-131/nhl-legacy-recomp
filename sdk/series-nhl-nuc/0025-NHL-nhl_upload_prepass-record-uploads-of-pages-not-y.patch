 #include <cstring>
 #include <utility>
 #include <vector>
@@ -26,6 +27,10 @@
 REXCVAR_DEFINE_BOOL(vulkan_sparse_shared_memory, true, "GPU/Vulkan",
                     "Use sparse shared memory on Vulkan")
     .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+REXCVAR_DEFINE_BOOL(nhl_upload_prepass, false, "GPU/Vulkan",
+                    "Record uploads of guest pages the GPU hasn't accessed yet in the current "
+                    "submission into a pre-pass that runs before it, instead of ending the render "
+                    "pass for each upload");
 
 namespace rex::graphics::vulkan {
 
@@ -166,10 +171,15 @@ bool VulkanSharedMemory::Initialize() {
       rex::align(ui::vulkan::VulkanUploadBufferPool::kDefaultPageSize, size_t(1)
                                                                            << page_size_log2()));
 
+  upload_prepass_ = std::make_unique<DeferredCommandBuffer>(command_processor_, 64 * 1024);
+  upload_prepass_empty_ = true;
+  submission_requested_pages_.assign(((kBufferSize >> page_size_log2()) + 63) >> 6, 0);
+
