@@ -140,6 +142,11 @@ class SharedMemory {
   virtual bool UploadRanges(
       const std::vector<std::pair<uint32_t, uint32_t>>& upload_page_ranges) = 0;
 
+  // Backends copy the guest pages of an upload into the upload buffer through this (after
+  // MakeRangeValid for them), so gpu_stream_skip_unchanged can remember the exact bytes the GPU
