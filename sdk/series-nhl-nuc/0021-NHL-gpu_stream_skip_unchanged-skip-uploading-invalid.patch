+
  private:
   memory::Memory& memory_;
 
@@ -161,6 +168,19 @@ class SharedMemory {
   // persistently allocated vector).
   std::vector<std::pair<uint32_t, uint32_t>> upload_ranges_;
 
+  // gpu_stream_skip_unchanged (after the Simpsons recomp's option of that name): the bytes
+  // each page was last uploaded with, which is what the GPU copy of the page holds until the
+  // GPU writes it. A page that was invalidated by a guest write (often only because a
+  // neighbouring page was written - invalidation is widened up to 256 KB) and still holds
+  // those bytes when it is requested again is made valid without an upload; a request whose
+  // pages are all unchanged then needs no upload, barrier or render pass break at all.
+  // Only touched on the command processor thread.
+  static constexpr size_t kStreamedPageShadowsMax = 16384;  // 64 MB with 4 KB pages
+  std::unordered_map<uint32_t, std::unique_ptr<uint8_t[]>> streamed_page_shadows_;
+  std::vector<std::pair<uint32_t, uint32_t>> kept_upload_ranges_;
+  void DropUnchangedPages();
+  void EraseStreamedPageShadows(uint32_t page_first, uint32_t page_last);
+
   // Mutex between the guest memory subsystem and the command processor, to be
   // locked when checking or updating validity of pages/ranges and when firing
   // watches.
