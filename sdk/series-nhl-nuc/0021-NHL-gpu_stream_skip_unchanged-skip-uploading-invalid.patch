   return UploadRanges(upload_ranges_);
 }
 
+void SharedMemory::DropUnchangedPages() {
+  // [nhl-skipunchanged] once per second: pages dropped/kept, requests needing no upload at all.
+  static uint64_t stat_dropped = 0, stat_kept = 0, stat_requests = 0, stat_skipped = 0;
+  static auto stat_t0 = std::chrono::steady_clock::now();
+  const uint32_t page_size = uint32_t(1) << page_size_log2_;
+  kept_upload_ranges_.clear();
+  auto keep = [this](uint32_t page) {
+    if (!kept_upload_ranges_.empty() &&
+        kept_upload_ranges_.back().first + kept_upload_ranges_.back().second == page) {
+      ++kept_upload_ranges_.back().second;
+    } else {
+      kept_upload_ranges_.emplace_back(page, 1);
+    }
+  };
+  for (const std::pair<uint32_t, uint32_t>& range : upload_ranges_) {
+    for (uint32_t page = range.first; page < range.first + range.second; ++page) {
+      auto shadow_it = streamed_page_shadows_.find(page);
+      if (shadow_it == streamed_page_shadows_.end()) {
+        keep(page);
+        ++stat_kept;
+        continue;
+      }
+      // Protect first, then compare, like an upload: a guest write after this point faults and
+      // invalidates the page again, so it can't be missed.
+      MakeRangeValid(page << page_size_log2_, page_size, false);
+      if (std::memcmp(shadow_it->second.get(), memory().TranslatePhysical(page << page_size_log2_),
+                      page_size) == 0) {
+        ++stat_dropped;
+      } else {
+        keep(page);
+        ++stat_kept;
+      }
+    }
+  }
+  ++stat_requests;
+  stat_skipped += kept_upload_ranges_.empty();
+  upload_ranges_.swap(kept_upload_ranges_);
+  const auto now = std::chrono::steady_clock::now();
+  if (now - stat_t0 >= std::chrono::seconds(1)) {
+    REXGPU_INFO("[nhl-skipunchanged] pages dropped={} uploaded={} requests={} fully_skipped={} "
+                "shadows={}",
+                stat_dropped, stat_kept, stat_requests, stat_skipped,
+                streamed_page_shadows_.size());
+    stat_dropped = stat_kept = stat_requests = stat_skipped = 0;
+    stat_t0 = now;
+  }
+}
+
+void SharedMemory::EraseStreamedPageShadows(uint32_t page_first, uint32_t page_last) {
+  if (streamed_page_shadows_.empty()) {
+    return;
+  }
+  if (page_last - page_first >= streamed_page_shadows_.size()) {
+    for (auto it = streamed_page_shadows_.begin(); it != streamed_page_shadows_.end();) {
+      if (it->first >= page_first && it->first <= page_last) {
+        it = streamed_page_shadows_.erase(it);
+      } else {
+        ++it;
+      }
+    }
+  } else {
+    for (uint32_t page = page_first; page <= page_last; ++page) {
+      streamed_page_shadows_.erase(page);
+    }
+  }
+}
+
+void SharedMemory::CopyPagesForUpload(uint32_t page_first, uint32_t page_count, uint8_t* dest) {
+  const size_t page_size = size_t(1) << page_size_log2_;
+  std::memcpy(dest, memory().TranslatePhysical(page_first << page_size_log2_),
+              page_count * page_size);
+  if (!REXCVAR_GET(gpu_stream_skip_unchanged)) {
+    if (!streamed_page_shadows_.empty()) {
+      streamed_page_shadows_.clear();
+    }
+    return;
+  }
+  // Shadow the bytes as copied to the upload buffer (what the GPU copy will hold), not a
+  // second read of guest memory, which a guest thread may have changed in between.
+  for (uint32_t i = 0; i < page_count; ++i) {
+    std::unique_ptr<uint8_t[]>& shadow = streamed_page_shadows_[page_first + i];
+    if (!shadow) {
+      if (streamed_page_shadows_.size() > kStreamedPageShadowsMax) {
+        // Too many pages to shadow (texture streaming, level loads): start over.
+        streamed_page_shadows_.clear();
+        return;
+      }
+      shadow = std::make_unique<uint8_t[]>(page_size);
+    }
+    std::memcpy(shadow.get(), dest + i * page_size, page_size);
+  }
+}
+
 bool SharedMemory::RequestRange(uint32_t start, uint32_t length) {
   std::pair<uint32_t, uint32_t> range(start, length);
   return RequestRanges(&range, 1);
