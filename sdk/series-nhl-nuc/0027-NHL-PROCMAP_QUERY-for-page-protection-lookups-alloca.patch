+// RegisterFile::GetRegisterInfo is a switch over ~3400 registers, too slow to run on every write.
+const std::bitset<RegisterFile::kRegisterCount> kKnownRegisters = [] {
+  std::bitset<RegisterFile::kRegisterCount> known;
+  for (uint32_t i = 0; i < RegisterFile::kRegisterCount; ++i) {
+    known[i] = RegisterFile::GetRegisterInfo(i) != nullptr;
+  }
+  return known;
+}();
+
+bool IsKnownRegister(uint32_t index) {
+  return kKnownRegisters[index];
+}
+
+}  // namespace
