-// Parse a line from /proc/self/maps into a LinuxMapEntry
-static bool ParseProcMapsLine(const std::string& line, LinuxMapEntry& out) {
+#ifdef PROCMAP_QUERY
+// PROCMAP_QUERY (Linux 6.11+): one VMA lookup without formatting and parsing the whole of
+// /proc/self/maps. Returns 1 found, 0 no mapping there, -1 not available on this kernel.
+static int QueryMapEntry(uintptr_t addr, LinuxMapEntry& out) {
+  static const int maps_fd = open("/proc/self/maps", O_RDONLY | O_CLOEXEC);
+  static std::atomic<bool> unsupported{maps_fd < 0};
+  if (unsupported.load(std::memory_order_relaxed)) {
+    return -1;
+  }
+  procmap_query q{};
+  q.size = sizeof(q);
+  q.query_addr = addr;
+  if (ioctl(maps_fd, PROCMAP_QUERY, &q) != 0) {
+    if (errno == ENOENT) {
+      return 0;
+    }
+    unsupported.store(true, std::memory_order_relaxed);
+    return -1;
+  }
+  out.start = static_cast<uintptr_t>(q.vma_start);
+  out.end = static_cast<uintptr_t>(q.vma_end);
+  out.perms[0] = (q.vma_flags & PROCMAP_QUERY_VMA_READABLE) ? 'r' : '-';
+  out.perms[1] = (q.vma_flags & PROCMAP_QUERY_VMA_WRITABLE) ? 'w' : '-';
+  out.perms[2] = (q.vma_flags & PROCMAP_QUERY_VMA_EXECUTABLE) ? 'x' : '-';
+  out.perms[3] = (q.vma_flags & PROCMAP_QUERY_VMA_SHARED) ? 's' : 'p';
+  return 1;
+}
+#endif  // PROCMAP_QUERY
+
+// Parse "start-end perms ..." from a /proc/self/maps line. No allocation: this runs in the
+// access violation handler.
+static bool ParseProcMapsLine(const char* line, LinuxMapEntry& out) {
   out = LinuxMapEntry{};
   unsigned long long start = 0, end = 0;
   char perms[5] = {};
-  const int matched = std::sscanf(line.c_str(), "%llx-%llx %4s", &start, &end, perms);
+  const int matched = std::sscanf(line, "%llx-%llx %4s", &start, &end, perms);
   if (matched < 3)
     return false;
   out.start = static_cast<uintptr_t>(start);
@@ -170,23 +213,52 @@ static bool ParseProcMapsLine(const std::string& line, LinuxMapEntry& out) {
   return out.start < out.end;
 }
 
-// Find the mapping entry in /proc/self/maps that contains the given address
+// Scan /proc/self/maps for the entry containing addr, stopping at the first one that does.
+static bool ScanMapsForAddress(uintptr_t addr, LinuxMapEntry& out_entry) {
+  const int fd = open("/proc/self/maps", O_RDONLY | O_CLOEXEC);
+  if (fd < 0)
+    return false;
+  char buffer[8192];
+  size_t used = 0;
+  bool found = false;
+  while (!found) {
+    const ssize_t got = read(fd, buffer + used, sizeof(buffer) - 1 - used);
+    if (got <= 0)
+      break;
+    used += static_cast<size_t>(got);
+    buffer[used] = '\0';
+    char* line = buffer;
+    while (char* newline = std::strchr(line, '\n')) {
+      *newline = '\0';
+      LinuxMapEntry e;
+      if (ParseProcMapsLine(line, e) && addr >= e.start && addr < e.end) {
+        out_entry = e;
+        found = true;
+        break;
+      }
+      line = newline + 1;
+    }
+    if (!found) {
+      used = static_cast<size_t>(buffer + used - line);
+      std::memmove(buffer, line, used);
+    }
+  }
+  close(fd);
+  return found;
+}
+
+// Find the mapping that contains the given address
 static bool FindEntryForAddress(void* address, LinuxMapEntry& out_entry) {
   const uintptr_t addr = reinterpret_cast<uintptr_t>(address);
