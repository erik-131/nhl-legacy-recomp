From 71906dfd5c99141914c928ec99df7d4d63337093 Mon Sep 17 00:00:00 2001
From: nhl <nhl@localhost>
Date: Fri, 30 Oct 2026 15:16:35 +0100
Subject: [PATCH] NHL fix: execute_unclipped_draw_vs_on_cpu defaults to true
 (rtv black 3D)

---
 src/graphics/util/draw_extent_estimator.cpp | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/graphics/util/draw_extent_estimator.cpp b/src/graphics/util/draw_extent_estimator.cpp
index 3027dc8..19bcd11 100644
--- a/src/graphics/util/draw_extent_estimator.cpp
+++ b/src/graphics/util/draw_extent_estimator.cpp
@@ -24,7 +24,12 @@
 #include <rex/memory.h>
 #include <rex/ui/graphics_util.h>
 
-REXCVAR_DEFINE_BOOL(execute_unclipped_draw_vs_on_cpu, false, "GPU",
+// NHL: default true as in upstream Xenia. With false, every draw with clipping
+// disabled (XDK clears, e.g. NHL's 4x MSAA depth-only clear quad between the
+// depth and colour resolves of the 3D pass) is estimated as full-scissor height,
+// so its render target claims the whole EDRAM with wrapping - on the host render
+// target path that transfers the 3D colour into a depth RT and back (black 3D).
+REXCVAR_DEFINE_BOOL(execute_unclipped_draw_vs_on_cpu, true, "GPU",
                     "Execute unclipped draw vertex shader on CPU");
 
 REXCVAR_DEFINE_BOOL(execute_unclipped_draw_vs_on_cpu_with_scissor, false, "GPU",
-- 
2.47.3

