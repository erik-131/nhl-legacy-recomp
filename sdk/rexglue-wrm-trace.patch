From 70b6e577b4fda90410f96dbc2559f731043e05df Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 29 Oct 2026 15:13:36 +0100
Subject: [PATCH] diag: REX_WRM_TRACE - WAIT_REG_MEM per-address wait stats

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HQAuyvWexFM1CJknxUd7jY
---
 src/graphics/command_processor.cpp | 48 ++++++++++++++++++++++++++++++
 1 file changed, 48 insertions(+)

diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index 5b9f82e..a5c81d3 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -12,6 +12,8 @@
 #include <algorithm>
 #include <chrono>
 #include <string>
+#include <unordered_map>
+#include <vector>
 #include <ctime>
 #include <cinttypes>
 #include <cmath>
@@ -1188,6 +1190,16 @@ bool CommandProcessor::ExecutePacketType3_WAIT_REG_MEM(memory::RingBuffer* reade
 
   bool is_memory = (wait_info & 0x10) != 0;
 
+  // NHL diag (REX_WRM_TRACE=1): which address/register the CP waits on, how
+  // often, how long, and how many poll iterations; logged once per second.
+  static const bool nhl_wrm_trace = [] {
+    const char* e = std::getenv("REX_WRM_TRACE");
+    return e && *e && *e != '0';
+  }();
+  const uint64_t nhl_wrm_t0 = nhl_wrm_trace ? NhlNowNs() : 0;
+  uint32_t nhl_wrm_iters = 0;
+  uint32_t nhl_wrm_first = 0, nhl_wrm_last = 0;
+
   bool matched = false;
   do {
     uint32_t value = 0;
@@ -1228,6 +1240,11 @@ bool CommandProcessor::ExecutePacketType3_WAIT_REG_MEM(memory::RingBuffer* reade
         matched = true;
         break;
     }
+    if (nhl_wrm_trace) {
+      if (nhl_wrm_iters == 0) nhl_wrm_first = value;
+      nhl_wrm_last = value;
+      ++nhl_wrm_iters;
+    }
     if (!matched) {
       // Wait.
       if (wait >= 0x100) {
@@ -1251,6 +1268,37 @@ bool CommandProcessor::ExecutePacketType3_WAIT_REG_MEM(memory::RingBuffer* reade
     }
   } while (!matched);
 
+  if (nhl_wrm_trace) {
+    struct Ent { uint64_t ns = 0, n = 0, waited = 0, iters = 0; uint32_t info, ref, mask, wait,
+                 first, last; };
+    static std::unordered_map<uint64_t, Ent> m;
+    static uint64_t win = NhlNowNs();
+    const uint64_t now = NhlNowNs();
+    Ent& e = m[(uint64_t(poll_reg_addr) << 8) | (wait_info & 0xFF)];
+    e.ns += now - nhl_wrm_t0;
+    ++e.n;
+    if (nhl_wrm_iters > 1) ++e.waited;
+    e.iters += nhl_wrm_iters;
+    e.info = wait_info; e.ref = ref; e.mask = mask; e.wait = wait;
+    e.first = nhl_wrm_first; e.last = nhl_wrm_last;
+    if (now - win >= 1000000000ull) {
+      std::vector<std::pair<uint64_t, Ent>> v(m.begin(), m.end());
+      std::sort(v.begin(), v.end(), [](auto& a, auto& b) { return a.second.ns > b.second.ns; });
+      std::string out;
+      for (size_t i = 0; i < v.size() && i < 6; ++i) {
+        const Ent& x = v[i].second;
+        out += fmt::format(" [{}{:08X} f{} ref={:08X} mask={:08X} wait={:X} n={} waited={} "
+                           "{:.1f}ms it={} first={:08X} last={:08X}]",
+                           (x.info & 0x10) ? "mem:" : "reg:", uint32_t(v[i].first >> 8),
+                           x.info & 7, x.ref, x.mask, x.wait, x.n, x.waited, x.ns / 1e6,
+                           x.iters, x.first, x.last);
+      }
+      REXGPU_INFO("[nhl-wrm] window={:.0f}ms{}", (now - win) / 1e6, out);
+      m.clear();
+      win = now;
+    }
+  }
+
   return true;
 }
 
